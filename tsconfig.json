{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "esnext",
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node", "bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@pims/types": ["./packages/types/src/index.ts"],
      "@pims/types/*": ["./packages/types/src/*"],
      "@pims/config": ["./packages/config/src/index.ts"],
      "@pims/config/*": ["./packages/config/src/*"],
      "@pims/pims-mock": ["./packages/pims-mock/src/index.ts"],
      "@pims/pims-mock/*": ["./packages/pims-mock/src/*"],
      "@pims/pims-adapter": ["./packages/pims-adapter/src/index.ts"],
      "@pims/pims-adapter/*": ["./packages/pims-adapter/src/*"],
      "@pims/models": ["./packages/models/src/index.ts"],
      "@pims/models/*": ["./packages/models/src/*"],
      "@pims/rag": ["./packages/rag/src/index.ts"],
      "@pims/rag/*": ["./packages/rag/src/*"],
      "@pims/evidence": ["./packages/evidence/src/index.ts"],
      "@pims/evidence/*": ["./packages/evidence/src/*"],
      "@pims/notices": ["./packages/notices/src/index.ts"],
      "@pims/notices/*": ["./packages/notices/src/*"],
      "@pims/agent": ["./packages/agent/src/index.ts"],
      "@pims/agent/*": ["./packages/agent/src/*"],
      "@tests/*": ["./tests/*"]
    },
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["packages", "tests", "vitest.config.ts"]
}
