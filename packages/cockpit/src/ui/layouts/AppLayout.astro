---
import BaseLayout from "@pims/cockpit/ui/layouts/BaseLayout.astro";
import Header from "@pims/cockpit/ui/components/Header.astro";
import SessionExpiredModal from "@pims/cockpit/ui/components/SessionExpiredModal.astro";
import Sidebar from "@pims/cockpit/ui/components/Sidebar.astro";
import FloatingChatWidget from "@pims/cockpit/ui/components/FloatingChatWidget.astro";

interface Props {
  title?: string;
  breadcrumb: string;
}

const { title, breadcrumb } = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex h-screen w-full bg-slate-950 text-slate-100 overflow-hidden font-sans">
    <Sidebar currentPath={Astro.url.pathname} transition:persist="cockpit-sidebar" />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <Header breadcrumb={breadcrumb} transition:persist="cockpit-header" />

      <main class="flex-1 overflow-y-auto p-6" transition:animate="fade">
        <slot />
      </main>
    </div>
  </div>
  <SessionExpiredModal />
  <FloatingChatWidget transition:persist="cockpit-floating-chat" />
</BaseLayout>

<script>
  import { getSession, startSessionWatchdog } from "@pims/cockpit/ui/lib/session.ts";
  import { sseClient } from "@pims/cockpit/ui/lib/sse-client.ts";
  import { CONSTANTS } from "@pims/types/constants.ts";

  function ensureSessionAndStream() {
    const session = getSession();
    if (session === null || session === undefined) {
      window.location.href = CONSTANTS.COCKPIT_ROUTE_LOGIN;
      return;
    }
    startSessionWatchdog();
    sseClient.start();
  }

  document.addEventListener(CONSTANTS.EVENT_ASTRO_PAGE_LOAD, ensureSessionAndStream);
  ensureSessionAndStream();
</script>
