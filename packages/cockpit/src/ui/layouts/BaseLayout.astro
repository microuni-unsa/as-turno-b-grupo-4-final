---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Glass-Box Cockpit | UNSA GESTITEL" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/src/ui/styles/starwind.css" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-blue-600/40 selection:text-white">
    <slot />
  </body>
</html>
