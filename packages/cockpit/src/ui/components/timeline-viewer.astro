---
import { formatDateTime } from "@pims/cockpit/ui/lib/utils.ts";
import { CONSTANTS } from "@pims/types/constants.ts";
import { Activity, Clock } from "lucide-astro";

interface TimelineItem {
  id: string;
  eventType: string;
  description: string;
  timestampUtc: string;
  actor: string;
}

interface Props {
  events?: TimelineItem[];
  incidentCode: string;
}

const rawEvents = Astro.props.events;
const events: TimelineItem[] = Array.isArray(rawEvents) ? rawEvents : [];
const { incidentCode } = Astro.props;

function getEventLabel(type: string): string {
  const labels = CONSTANTS.EVENT_TYPE_LABELS as Record<string, string>;
  const found = labels[type];
  if (typeof found === "string") {
    return found;
  }
  return `Evento (${type})`;
}
---

<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4 shadow-sm">
  <div class="flex items-center justify-between pb-3 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <Activity class="w-4 h-4 text-blue-400" />
      <h3 class="text-sm font-semibold text-white">Historial de Eventos</h3>
    </div>
    <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-900">
      {incidentCode}
    </span>
  </div>

  <div class="space-y-4">
    {
      events.length === 0 ? (
        <div class="text-center py-8 text-slate-500 text-xs space-y-1">
          <Clock class="w-6 h-6 mx-auto text-slate-600 mb-1" />
          <p class="font-medium text-slate-400">Sin eventos registrados</p>
          <p class="text-[11px]">Las transiciones de estado y notificaciones aparecerán aquí automáticamente.</p>
        </div>
      ) : (
        <ol class="relative border-l border-slate-800 ml-3 space-y-4">
          {events.map((ev) => {
            const formattedTime = formatDateTime(ev.timestampUtc);
            const label = getEventLabel(ev.eventType);
            return (
              <li class="ml-4 space-y-1">
                <div class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full border border-blue-500 bg-slate-950" />
                <div class="flex items-center justify-between text-xs">
                  <span class="font-semibold text-slate-200">{label}</span>
                  <span class="text-[10px] font-mono text-slate-500">{formattedTime}</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">{ev.description}</p>
                <div class="text-[10px] text-slate-500 font-mono">
                  <span>Operador / Agente: {ev.actor}</span>
                </div>
              </li>
            );
          })}
        </ol>
      )
    }
  </div>
</div>
