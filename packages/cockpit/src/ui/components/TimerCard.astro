---
import { CONSTANTS } from "@pims/types/constants.ts";
import { Clock } from "lucide-astro";

interface Props {
  timerId: string;
  incidentCode: string;
  timerKind: string;
  fireAtUtc: string;
  remainingMs: number;
}

const { timerId, incidentCode, timerKind, fireAtUtc, remainingMs } =
  Astro.props;

function getTimerFriendlyName(kind: string): string {
  switch (kind) {
    case "T72_AUTHORITY":
    case "T_AUTHORITY_72H":
      return "Plazo Legal Art. 33 (72h)";
    case "T_REVIEW_SLA":
    case "T_INTERNAL_SLA":
      return `SLA Revisión DPO (${CONSTANTS.SLA_REVIEW_H}h)`;
    case "T_SUBJECT":
      return `Plazo Comunicación Titulares Art. 34 (${CONSTANTS.SLA_SUBJECT_H}h)`;
    case "T_PROCESSOR":
      return "Plazo Notificación Encargado";
    case "T_PERU_ADVISORY":
      return `Aviso Preventivo Perú (${CONSTANTS.PERU_ADVISORY_H}h)`;
    case "T_PHASE_FOLLOWUP":
      return "Seguimiento de Notificación por Fases";
    case "T_RETRY":
      return "Reintento de Notificación Automático";
    default:
      return `Temporizador no catalogado (${kind})`;
  }
}

function formatDeadlineDate(utcDateStr: string): string {
  const d = new Date(utcDateStr);
  if (Number.isNaN(d.getTime())) {
    return "Fecha límite no disponible";
  }
  return d.toLocaleString(CONSTANTS.LOCALE_ES_PE);
}

const formattedDeadline = formatDeadlineDate(fireAtUtc);
---

<div
  data-timer-card={timerId}
  class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col justify-between space-y-3 shadow-sm hover:border-slate-700 transition-colors"
>
  <div class="flex items-start justify-between">
    <div class="space-y-1">
      <div class="flex items-center space-x-2">
        <span class="px-2 py-0.5 rounded text-xs font-semibold bg-blue-950 text-blue-400 border border-blue-900">
          {incidentCode}
        </span>
        <span class="text-xs font-medium text-slate-400">
          {getTimerFriendlyName(timerKind)}
        </span>
      </div>
      <p class="text-xs text-slate-500">
        Vence: {formattedDeadline}
      </p>
    </div>
    <div class="p-2 rounded-lg bg-slate-800 text-slate-300">
      <Clock class="w-4 h-4" />
    </div>
  </div>

  <div class="pt-2 border-t border-slate-800/80 flex items-baseline justify-between">
    <span class="text-xs text-slate-400">Tiempo restante:</span>
    <span
      data-remaining-display={timerId}
      data-remaining-ms={remainingMs}
      data-fire-at={fireAtUtc}
      class="text-xl font-bold font-mono tracking-tight text-white tabular-nums"
    >
      --:--:--
    </span>
  </div>
</div>

<script>
  import { formatRemainingTime } from "@pims/cockpit/ui/lib/utils.ts";
  import { CONSTANTS } from "@pims/types/constants.ts";

  const TIMER_BASE_CLASS = "text-xl font-bold font-mono tracking-tight tabular-nums";
  const CLASS_EXPIRED = `${TIMER_BASE_CLASS} text-rose-500 animate-pulse`;
  const CLASS_URGENT = `${TIMER_BASE_CLASS} text-rose-400`;
  const CLASS_WARNING = `${TIMER_BASE_CLASS} text-amber-400`;
  const CLASS_NORMAL = `${TIMER_BASE_CLASS} text-emerald-400`;

  function getRemainingMsFromElement(el: Element): number {
    const fireAt = el.getAttribute("data-fire-at");
    if (fireAt) {
      const targetTime = new Date(fireAt).getTime();
      if (!Number.isNaN(targetTime)) {
        return Math.max(0, targetTime - Date.now());
      }
    }
    const raw = el.getAttribute("data-remaining-ms");
    if (raw === null || raw === "") {
      return 0;
    }
    const parsed = Number(raw);
    if (Number.isNaN(parsed)) {
      return 0;
    }
    return Math.max(0, parsed);
  }

  function tickTimers() {
    const displays = document.querySelectorAll("[data-remaining-display]");
    for (const el of displays) {
      const currentMs = getRemainingMsFromElement(el);
      el.setAttribute("data-remaining-ms", String(currentMs));
      el.textContent = formatRemainingTime(currentMs);

      // Color coding based on urgency
      if (currentMs <= 0) {
        el.className = CLASS_EXPIRED;
      } else if (currentMs < 4 * CONSTANTS.MS_PER_HOUR) {
        el.className = CLASS_URGENT;
      } else if (currentMs < 12 * CONSTANTS.MS_PER_HOUR) {
        el.className = CLASS_WARNING;
      } else {
        el.className = CLASS_NORMAL;
      }
    }
  }

  // Update immediately and then every second
  tickTimers();
  setInterval(tickTimers, CONSTANTS.MS_PER_SECOND);

  // Sync with SSE agent timer ticks
  window.addEventListener(CONSTANTS.EVENT_COCKPIT_AGENT_EVENT, ((e: CustomEvent) => {
    if (!e.detail || typeof e.detail !== "object") {
      return;
    }
    const event = e.detail;
    if (event.type === CONSTANTS.EVENT_SCHEDULER_TIMER_TICK) {
      const el = document.querySelector(`[data-remaining-display="${event.timer_id}"]`);
      if (el) {
        el.setAttribute("data-remaining-ms", String(event.remaining_ms));
        el.textContent = formatRemainingTime(event.remaining_ms);
      } else {
        // Explicit non-fatal handling for timer not displayed on current view
      }
    } else {
      // Explicit non-fatal handling for other agent event types
    }
  }) as EventListener);
</script>
