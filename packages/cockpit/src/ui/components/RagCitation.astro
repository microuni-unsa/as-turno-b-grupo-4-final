---
import { CONSTANTS } from "@pims/types/constants.ts";
import { BookOpen, Copy } from "lucide-astro";

interface Props {
  citation: string;
  docId: string;
  chunkId: string;
  lines: string;
  chunkSha256: string;
  denseScore: number | null;
  bm25Rank: number | null;
  rrfScore: number;
  rerankScore: number;
  text: string;
}

const {
  citation,
  docId,
  chunkId,
  lines,
  chunkSha256,
  denseScore,
  bm25Rank,
  rrfScore,
  rerankScore,
  text,
} = Astro.props;

function formatScore(score: number | null): string {
  if (score === null || Number.isNaN(score)) {
    return "—";
  }
  return score.toFixed(CONSTANTS.SCORE_DECIMAL_PLACES);
}

function formatRank(rank: number | null): string {
  if (rank === null || Number.isNaN(rank)) {
    return "—";
  }
  return `#${rank}`;
}

const formattedDenseScore = formatScore(denseScore);
const formattedBm25Rank = formatRank(bm25Rank);
const formattedRrfScore = formatScore(rrfScore);
const formattedRerankScore = formatScore(rerankScore);
const cleanText = text.replace(/^\[DOC:[^\]]+\]\s*/i, "").trim();
const shortChunkSha = chunkSha256.slice(0, CONSTANTS.SHORT_HASH_LENGTH);
---

<div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3 hover:border-slate-700 transition-colors shadow-sm">
  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div class="space-y-1 min-w-0">
      <div class="flex items-center space-x-2">
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-xs font-semibold bg-blue-950 text-blue-300 border border-blue-800">
          <BookOpen class="w-3 h-3 mr-1 inline" />
          {citation}
        </span>
        <span class="text-xs text-slate-400 font-mono truncate">
          {docId} · {chunkId} ({lines})
        </span>
      </div>
    </div>

    <div class="flex items-center space-x-2 shrink-0">
      <!-- RAG Metrics Tooltip Trigger (No random colors) -->
      <div class="relative group/rag inline-block">
        <button
          type="button"
          tabindex="0"
          class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono transition-colors flex items-center space-x-1.5 cursor-help"
          title="Inspeccionar métricas de recuperación RAG"
        >
          <span class="text-slate-400">Puntajes RAG</span>
          <span class="text-slate-300 font-sans text-[11px]">(Rerank: {formattedRerankScore})</span>
        </button>

        <!-- Popover Tooltip with NO random colors -->
        <div class="invisible group-hover/rag:visible group-focus-within/rag:visible absolute right-0 top-full mt-1.5 z-30 w-64 p-3 bg-slate-900 border border-slate-700 rounded-lg shadow-xl text-xs space-y-2 pointer-events-none transition-all">
          <div class="text-[11px] font-semibold text-slate-300 border-b border-slate-800 pb-1 flex items-center justify-between">
            <span>Métricas de Recuperación RAG</span>
            <span class="text-slate-400 font-mono text-[10px]">Dual-Modal</span>
          </div>
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-400">
              <span>Similitud Densa (Dense):</span>
              <span class="font-mono text-slate-200 tabular-nums">{formattedDenseScore}</span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Rango Léxico (BM25):</span>
              <span class="font-mono text-slate-200 tabular-nums">{formattedBm25Rank}</span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Reciprocal Rank (RRF):</span>
              <span class="font-mono text-slate-200 tabular-nums">{formattedRrfScore}</span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Rerank Cross-Encoder:</span>
              <span class="font-mono text-slate-200 font-semibold tabular-nums">{formattedRerankScore}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Copy hash button -->
      <button
        type="button"
        data-copy-hash={chunkSha256}
        class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors text-xs flex items-center space-x-1 border border-slate-700 shrink-0"
        title="Copiar hash del fragmento"
      >
        <Copy class="w-3 h-3" />
        <span class="font-mono text-[10px]">{shortChunkSha}…</span>
      </button>
    </div>
  </div>

  <!-- Verbatim text quote in clean sans-serif -->
  <blockquote class="text-xs text-slate-200 bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 leading-relaxed font-sans">
    "{cleanText}"
  </blockquote>
</div>

<script>
  import { CONSTANTS } from "@pims/types/constants.ts";

  document.querySelectorAll("[data-copy-hash]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const hash = btn.getAttribute("data-copy-hash");
      if (hash && hash.trim().length > 0) {
        navigator.clipboard.writeText(hash.trim());
        const originalText = btn.innerHTML;
        btn.innerHTML = `<span class="text-emerald-400 text-[10px]">¡Copiado!</span>`;
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, CONSTANTS.COPY_FEEDBACK_DELAY_MS);
      } else {
        throw new Error("Attribute data-copy-hash is missing or empty");
      }
    });
  });
</script>
