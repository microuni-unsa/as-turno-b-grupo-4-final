---
import { CONSTANTS } from "@pims/types/constants.ts";
import {
  AlertTriangle,
  LogOut,
  MessageSquare,
  PlusCircle,
  ShieldCheck,
  Terminal,
} from "lucide-astro";

interface Props {
  currentPath?: string;
}

const currentPath =
  typeof Astro.props.currentPath === "string"
    ? Astro.props.currentPath
    : Astro.url.pathname;

const navItems = [
  {
    href: CONSTANTS.COCKPIT_ROUTE_INCIDENTS,
    label: "Incidentes",
    icon: AlertTriangle,
    permission: CONSTANTS.PERMISSION_VIEW_INCIDENT,
  },
  {
    href: CONSTANTS.COCKPIT_ROUTE_NEW,
    label: "Nuevo Incidente",
    icon: PlusCircle,
    permission: CONSTANTS.PERMISSION_CHANGE_INCIDENT,
  },
  {
    href: CONSTANTS.COCKPIT_ROUTE_COMPLIANCE,
    label: "Cumplimiento DPO",
    icon: ShieldCheck,
    permission: CONSTANTS.PERMISSION_VIEW_INCIDENT,
  },
  {
    href: CONSTANTS.COCKPIT_ROUTE_SECURITY_LOG,
    label: "Bitácora de Seguridad",
    icon: Terminal,
    permission: CONSTANTS.PERMISSION_VIEW_SECURITYLOG,
  },
  {
    href: CONSTANTS.COCKPIT_ROUTE_CHAT,
    label: "Asistente IA",
    icon: MessageSquare,
    permission: CONSTANTS.PERMISSION_VIEW_INCIDENT,
  },
];
---

<aside class="bg-slate-900 text-slate-100 flex flex-col h-screen border-r border-slate-800 shrink-0 select-none w-72 transition-all duration-300">
  <!-- Brand / Tenant header -->
  <a
    href={CONSTANTS.COCKPIT_ROUTE_INCIDENTS}
    class="p-6 border-b border-slate-800 flex items-center hover:bg-slate-800/40 transition-colors space-x-3.5"
  >
    <div
      class="w-9 h-9 bg-blue-600 rounded-lg flex items-center justify-center font-bold text-white text-lg tracking-wider shadow-md shadow-blue-500/25 shrink-0"
    >
      U
    </div>
    <div class="min-w-0 flex-1">
      <h1 class="font-bold text-base leading-tight tracking-wide text-white uppercase truncate">
        UNSA
      </h1>
      <p class="text-xs text-slate-400 font-medium truncate">
        Gestión Integrada
      </p>
    </div>
  </a>

  <!-- Navigation -->
  <div class="flex-1 py-5 px-3 overflow-y-auto space-y-6">
    <div>
      <h2 class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
        Módulos
      </h2>
      <nav class="space-y-1" id="cockpit-nav">
        {
          navItems.map((item) => {
            const Icon = item.icon;
            const isActive =
              currentPath === item.href ||
              (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                data-permission={item.permission}
                class:list={[
                  "w-full flex items-center space-x-3 rounded-lg text-sm font-medium transition-all duration-150 px-3 py-2.5",
                  isActive
                    ? "bg-blue-600 text-white shadow-sm shadow-blue-600/30"
                    : "text-slate-300 hover:bg-slate-800/70 hover:text-white",
                ]}
              >
                <Icon class:list={["w-4 h-4 shrink-0", isActive ? "text-white" : "text-slate-400"]} />
                <span class="truncate">{item.label}</span>
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>

  <!-- User profile footer -->
  <div class="p-4 border-t border-slate-800 bg-slate-900/80">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3 min-w-0">
        <div
          id="user-avatar"
          class="w-8 h-8 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center font-semibold text-xs text-slate-200 shrink-0 uppercase"
        >
          U
        </div>
        <div class="min-w-0 flex-1">
          <p id="user-name" class="text-xs font-semibold text-white truncate">
            Cargando...
          </p>
          <div class="flex items-center space-x-1.5">
            <span
              id="user-role-badge"
              class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium bg-blue-950 text-blue-300 border border-blue-800/80 uppercase tracking-wider"
            >
              Operador
            </span>
          </div>
        </div>
      </div>
      <button
        id="btn-logout"
        title="Cerrar sesión"
        class="p-1.5 rounded-md text-slate-400 hover:text-rose-400 hover:bg-rose-950/40 transition-colors"
      >
        <LogOut class="w-4 h-4" />
      </button>
    </div>
  </div>
</aside>

<script>
  import { clearSession, getSession, hasPermission } from "@pims/cockpit/ui/lib/session.ts";
  import { CONSTANTS } from "@pims/types/constants.ts";

  const NAV_ACTIVE_CLASS =
    "w-full flex items-center space-x-3 rounded-lg text-sm font-medium transition-all duration-150 px-3 py-2.5 bg-blue-600 text-white shadow-sm shadow-blue-600/30";
  const NAV_INACTIVE_CLASS =
    "w-full flex items-center space-x-3 rounded-lg text-sm font-medium transition-all duration-150 px-3 py-2.5 text-slate-300 hover:bg-slate-800/70 hover:text-white";

  function getAvatarInitial(username: string): string {
    if (typeof username === "string" && username.trim().length > 0) {
      return username.trim().charAt(0).toUpperCase();
    }
    return "U";
  }

  function syncSidebar() {
    const session = getSession();
    const avatar = document.getElementById("user-avatar");
    const nameEl = document.getElementById("user-name");
    const roleBadge = document.getElementById("user-role-badge");

    if (!avatar) {
      throw new Error("Element #user-avatar not found in DOM");
    }
    if (!nameEl) {
      throw new Error("Element #user-name not found in DOM");
    }
    if (!roleBadge) {
      throw new Error("Element #user-role-badge not found in DOM");
    }

    if (session) {
      avatar.textContent = getAvatarInitial(session.username);
      nameEl.textContent = session.username;
      roleBadge.textContent = session.native_role;

      // Filter nav items based on permissions
      const navLinks = document.querySelectorAll("#cockpit-nav a[data-permission]");
      for (const link of navLinks) {
        const permission = link.getAttribute("data-permission") as any;
        if (permission) {
          if (hasPermission(session, permission)) {
            (link as HTMLElement).style.display = "";
          } else {
            (link as HTMLElement).style.display = "none";
          }
        } else {
          (link as HTMLElement).style.display = "";
        }
      }
    } else {
      // Unauthenticated state
      avatar.textContent = "—";
      nameEl.textContent = "Sin autenticar";
      roleBadge.textContent = "Invitado";

      const navLinks = document.querySelectorAll("#cockpit-nav a[data-permission]");
      for (const link of navLinks) {
        (link as HTMLElement).style.display = "none";
      }
    }

    // Update active state based on current location
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll("#cockpit-nav a");
    links.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive =
        currentPath === href ||
        (href !== "/" && href !== null && currentPath.startsWith(href));
      const icon = link.querySelector("svg");

      if (isActive) {
        link.className = NAV_ACTIVE_CLASS;
        if (icon) {
          icon.setAttribute("class", "w-4 h-4 shrink-0 text-white");
        } else {
          throw new Error("SVG icon missing in nav link");
        }
      } else {
        link.className = NAV_INACTIVE_CLASS;
        if (icon) {
          icon.setAttribute("class", "w-4 h-4 shrink-0 text-slate-400");
        } else {
          throw new Error("SVG icon missing in nav link");
        }
      }
    });

    const logoutBtn = document.getElementById("btn-logout");
    if (logoutBtn) {
      logoutBtn.onclick = () => {
        clearSession();
        window.location.href = CONSTANTS.COCKPIT_ROUTE_LOGIN;
      };
    } else {
      throw new Error("Element #btn-logout not found in DOM");
    }
  }

  document.addEventListener(CONSTANTS.EVENT_ASTRO_PAGE_LOAD, syncSidebar);
  syncSidebar();
</script>
