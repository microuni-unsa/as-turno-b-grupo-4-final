---
import { formatDateTime } from "@pims/cockpit/ui/lib/utils.ts";
import { CONSTANTS } from "@pims/types/constants.ts";
import { FileCode, FileText, Lock, ShieldCheck } from "lucide-astro";

interface EvidenceItem {
  id: string;
  filename: string;
  sha256Hex: string;
  byteSize: number;
  mimeType: string;
  createdAtUtc: string;
}

interface Props {
  evidenceList?: EvidenceItem[];
  bundleSealed?: boolean;
}

const rawList = Astro.props.evidenceList;
const evidenceList: EvidenceItem[] = Array.isArray(rawList) ? rawList : [];
const bundleSealed = typeof Astro.props.bundleSealed === "boolean" ? Astro.props.bundleSealed : false;

function formatBytes(bytes: number): string {
  if (bytes <= 0 || Number.isNaN(bytes)) {
    return "0 B";
  }
  if (bytes < 1024) {
    return `${bytes} B`;
  }
  if (bytes < 1024 * 1024) {
    return `${(bytes / 1024).toFixed(1)} KB`;
  }
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}
---

<aside class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4 shadow-sm" aria-label="Bóveda de Evidencias">
  <div class="flex items-center justify-between pb-3 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <Lock class="w-4 h-4 text-emerald-400" />
      <h3 class="text-sm font-semibold text-white">Bóveda Criptográfica de Evidencias</h3>
    </div>
    {
      bundleSealed ? (
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800">
          <ShieldCheck class="w-3 h-3" />
          <span>Bundle Sellado</span>
        </span>
      ) : (
        <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-950 text-amber-300 border border-amber-800">
          En Custodia
        </span>
      )
    }
  </div>

  <div class="space-y-3">
    {
      evidenceList.length === 0 ? (
        <div class="text-center py-6 text-slate-500 text-xs space-y-1">
          <FileCode class="w-6 h-6 mx-auto text-slate-600 mb-1" />
          <p class="font-medium text-slate-400">Sin evidencias adjuntas</p>
          <p class="text-[11px]">Los archivos subidos se sellarán criptográficamente con {CONSTANTS.DEFAULT_CIPHER_ALGORITHM}.</p>
        </div>
      ) : (
        evidenceList.map((item) => {
          const shortSha = item.sha256Hex.slice(0, CONSTANTS.SHORT_HASH_LENGTH);
          const sizeStr = formatBytes(item.byteSize);
          const dateStr = formatDateTime(item.createdAtUtc);
          return (
            <div class="p-3 bg-slate-950/70 border border-slate-800 rounded-lg space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2 min-w-0">
                  <FileText class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                  <span class="text-xs font-semibold text-slate-200 truncate">{item.filename}</span>
                </div>
                <span class="text-[10px] font-mono text-slate-400">{sizeStr}</span>
              </div>
              <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 pt-1 border-t border-slate-800/60">
                <span title={item.sha256Hex}>SHA-256: {shortSha}…</span>
                <span>{dateStr}</span>
              </div>
            </div>
          );
        })
      )
    }
  </div>
</aside>
