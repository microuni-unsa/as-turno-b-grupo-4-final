---
import { renderMarkdown } from "@pims/cockpit/ui/lib/markdown.ts";
import { CONSTANTS } from "@pims/types/constants.ts";
import { Bot, Send, User } from "lucide-astro";

interface ChatMessage {
  id: string;
  sender: "user" | "assistant";
  text: string;
  timestamp: string;
}

interface Props {
  messages?: ChatMessage[];
  title?: string;
}

const rawMessages = Astro.props.messages;
const messages: ChatMessage[] = Array.isArray(rawMessages) ? rawMessages : [];
const title =
  typeof Astro.props.title === "string" && Astro.props.title.trim().length > 0
    ? Astro.props.title.trim()
    : CONSTANTS.DEFAULT_CHAT_TITLE;
---

<div class="flex flex-col h-full bg-slate-950 border border-slate-800 rounded-xl overflow-hidden">
  <div class="p-3 border-b border-slate-800 bg-slate-900/80 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <Bot class="w-4 h-4 text-blue-400" />
      <span class="text-xs font-semibold text-white">{title}</span>
    </div>
    <span class="text-[10px] text-slate-400 font-mono">
      {messages.length === 0 ? "0 mensajes" : `${messages.length} mensajes`}
    </span>
  </div>

  <div class="flex-1 p-4 overflow-y-auto space-y-3">
    {
      messages.length === 0 ? (
        <div class="flex flex-col items-center justify-center h-full text-center p-6 space-y-2 text-slate-400">
          <Bot class="w-8 h-8 text-slate-600 mb-1" />
          <p class="text-xs font-medium text-slate-300">Sin mensajes en la conversación</p>
          <p class="text-[11px] text-slate-500">
            Inicie el diálogo con el asistente para recibir ayuda en la gestión del incidente.
          </p>
        </div>
      ) : (
        messages.map((msg) => {
          const isUser = msg.sender === "user";
          return (
            <div class={isUser ? "flex justify-end" : "flex justify-start"}>
              <div
                class:list={[
                  "max-w-[85%] rounded-2xl p-3 text-xs shadow-md space-y-1",
                  isUser
                    ? "bg-blue-600 text-white rounded-br-sm"
                    : "bg-slate-900 border border-slate-800 text-slate-200 rounded-bl-sm",
                ]}
              >
                <div class="flex items-center space-x-1.5 text-[10px] opacity-75">
                  {isUser ? <User class="w-3 h-3" /> : <Bot class="w-3 h-3" />}
                  <span class="font-medium">{isUser ? "Operador" : title}</span>
                  <span>·</span>
                  <span class="font-mono">{msg.timestamp}</span>
                </div>
                {
                  isUser ? (
                    <p class="leading-relaxed whitespace-pre-wrap">{msg.text}</p>
                  ) : (
                    <div class="markdown-content leading-relaxed" set:html={renderMarkdown(msg.text)} />
                  )
                }
              </div>
            </div>
          );
        })
      )
    }
  </div>

  <div class="p-3 border-t border-slate-800 bg-slate-900/60">
    <form class="flex items-center space-x-2" id="chat-interface-form">
      <input
        type="text"
        id="chat-interface-input"
        placeholder="Escriba su consulta..."
        class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder:text-slate-500 focus:border-blue-500 focus:outline-none"
      />
      <button
        type="submit"
        class="px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-lg flex items-center space-x-1.5 transition-colors"
      >
        <Send class="w-3.5 h-3.5" />
        <span>Enviar</span>
      </button>
    </form>
  </div>
</div>
