---
import { Activity, Clock } from "lucide-astro";

interface Props {
  breadcrumb: string;
}

const { breadcrumb } = Astro.props;
---

<header class="h-14 border-b border-slate-800 bg-slate-900/60 backdrop-blur-md px-6 flex items-center justify-between shrink-0">
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs font-medium text-slate-400">
    <span class="text-slate-500">Módulo Activo</span>
    <span class="text-slate-600">/</span>
    <span id="header-breadcrumb-label" class="text-slate-200 font-semibold">{breadcrumb}</span>
  </div>

  <!-- Right status indicators -->
  <div class="flex items-center space-x-4">
    <!-- Urgent timer banner if active -->
    <div
      id="header-urgent-timer"
      class="hidden items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-950/80 text-amber-300 border border-amber-800/80 animate-pulse"
    >
      <Clock class="w-3.5 h-3.5" />
      <span id="header-urgent-label">Plazo 72h: 00:00:00</span>
    </div>

    <!-- SSE status badge -->
    <div
      id="sse-status-badge"
      class="flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700 transition-colors"
    >
      <span
        id="sse-pulse-dot"
        class="w-2 h-2 rounded-full bg-slate-500 transition-colors"
      ></span>
      <span id="sse-status-text">Conectando...</span>
    </div>

    <!-- PIMS Service status -->
    <div class="flex items-center space-x-1.5 text-xs text-slate-400 border-l border-slate-800 pl-4">
      <Activity class="w-3.5 h-3.5 text-emerald-400" />
      <span>Servicio Activo</span>
    </div>
  </div>
</header>

<script>
  import { sseClient } from "@pims/cockpit/ui/lib/sse-client.ts";
  import { formatRemainingTime } from "@pims/cockpit/ui/lib/utils.ts";

  function updateStatus(status: string) {
    const statusBadge = document.getElementById("sse-status-badge");
    const pulseDot = document.getElementById("sse-pulse-dot");
    const statusText = document.getElementById("sse-status-text");
    if (!statusBadge || !pulseDot || !statusText) return;
    if (status === "connected") {
      pulseDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
      statusBadge.className = "flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-950/60 text-emerald-300 border border-emerald-800/70";
      statusText.textContent = "En vivo (SSE)";
    } else if (status === "connecting") {
      pulseDot.className = "w-2 h-2 rounded-full bg-amber-400";
      statusBadge.className = "flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-950/60 text-amber-300 border border-amber-800/70";
      statusText.textContent = "Reconectando...";
    } else {
      pulseDot.className = "w-2 h-2 rounded-full bg-rose-400";
      statusBadge.className = "flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-medium bg-rose-950/60 text-rose-300 border border-rose-800/70";
      statusText.textContent = "Desconectado";
    }
  }

  window.addEventListener("cockpit:connection-status", ((e: CustomEvent) => {
    updateStatus(e.detail.status);
  }) as EventListener);

  // Listen to timer ticks
  window.addEventListener("cockpit:agent-event", ((e: CustomEvent) => {
    const event = e.detail;
    const urgentTimer = document.getElementById("header-urgent-timer");
    const urgentLabel = document.getElementById("header-urgent-label");
    if (event.type === "scheduler:timer_tick" && urgentTimer && urgentLabel) {
      if (
        (event.timer_kind === "T_AUTHORITY_72H" ||
          event.timer_kind === "T72_AUTHORITY") &&
        event.remaining_ms < 12 * 3600 * 1000
      ) {
        urgentTimer.classList.remove("hidden");
        urgentTimer.classList.add("flex");
        urgentLabel.textContent = `Art. 33: ${formatRemainingTime(event.remaining_ms)}`;
      }
    }
  }) as EventListener);

  function syncHeaderOnPageLoad() {
    updateStatus(sseClient.getState().status);
    const path = window.location.pathname;
    const breadcrumbLabel = document.getElementById("header-breadcrumb-label");
    if (breadcrumbLabel) {
      if (path.startsWith("/incidents")) breadcrumbLabel.textContent = "Incidentes";
      else if (path.startsWith("/compliance")) breadcrumbLabel.textContent = "Cumplimiento DPO";
      else if (path.startsWith("/security-log")) breadcrumbLabel.textContent = "Bitácora de Seguridad";
      else if (path.startsWith("/chat")) breadcrumbLabel.textContent = "Asistente IA";
    }
  }

  document.addEventListener("astro:page-load", syncHeaderOnPageLoad);
  syncHeaderOnPageLoad();
</script>
