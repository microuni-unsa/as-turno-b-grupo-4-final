          <div>
            <h3 class="text-sm font-semibold text-white">6. Acciones de Contención, Análisis y Resolución</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Acciones ejecutadas. El orquestador generará las acciones automáticamente.</p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-[11px] font-medium text-slate-500 bg-slate-800 px-2 py-0.5 rounded">Opcional</span>
            <button
              id="btn-add-action"
              type="button"
              class="px-2.5 py-1 rounded-lg bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 text-xs font-medium transition-colors flex items-center space-x-1 border border-blue-500/30"
            >
              <Plus class="w-3.5 h-3.5" />
              <span>Agregar acción</span>
            </button>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-slate-950/40 border border-slate-800 text-xs text-slate-400 flex items-start space-x-2">
          <Info class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" />
          <p>
            No es obligatorio registrar acciones en este momento. El orquestador del agente generará y auditará automáticamente las acciones de contención (C), análisis de causa raíz (A) y resolución (R) en el PIMS durante la atención del incidente.
          </p>
        </div>

        <!-- Dynamic Action List -->
        <div id="container-actions" class="space-y-3">
          <!-- Dynamically populated or empty -->
        </div>
      </div>

      <!-- Submit Section -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-800">
        <a
          href="/incidents"
          class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition-colors"
        >
          Cancelar
        </a>
        <button
          id="btn-submit-incident"
          type="submit"
          class="px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition-colors flex items-center space-x-2 shadow-sm"
        >
          <Send class="w-4 h-4" />
          <span>Registrar incidente</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Explain Popover Modal -->
  <div id="modal-explain" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl max-w-lg w-full p-5 shadow-xl space-y-3">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h3 id="modal-explain-title" class="text-sm font-semibold text-white"></h3>
        <button id="btn-close-explain" type="button" class="text-slate-400 hover:text-white">
          <X class="w-4 h-4" />
        </button>
      </div>
      <div id="modal-explain-content" class="text-xs text-slate-300 space-y-2"></div>
      <div id="modal-explain-citations" class="text-[11px] text-blue-400 space-y-1"></div>
    </div>
  </div>
</AppLayout>

<style>
  .provenance-badge {
    font-size: 10px;
    line-height: 1rem;
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    border-width: 1px;
    border-style: solid;
  }
  .provenance-narrative {
    background-color: rgba(59, 130, 246, 0.15);
    color: rgb(147, 197, 253);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .provenance-partial {
    background-color: rgba(245, 158, 11, 0.15);
    color: rgb(252, 211, 77);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .provenance-default {
    background-color: rgba(51, 65, 85, 0.5);
    color: rgb(203, 213, 225);
    border-color: rgb(71, 85, 105);
  }
</style>

<script>
  import { authenticatedFetch } from "@pims/cockpit/ui/lib/api.ts";

  const narrativeInput = document.getElementById("input-narrative") as HTMLTextAreaElement;
  const charCount = document.getElementById("char-count");
  const btnDictate = document.getElementById("btn-dictate");
  const iconMic = document.getElementById("icon-mic");
  const iconMicOff = document.getElementById("icon-mic-off");
  const labelDictate = document.getElementById("label-dictate");
  const speechIndicator = document.getElementById("speech-indicator");
  const btnDraftAi = document.getElementById("btn-draft-ai");
  const incidentForm = document.getElementById("incident-form") as HTMLFormElement;
  const modalExplain = document.getElementById("modal-explain");
  const modalExplainTitle = document.getElementById("modal-explain-title");
  const modalExplainContent = document.getElementById("modal-explain-content");
  const modalExplainCitations = document.getElementById("modal-explain-citations");
  const btnCloseExplain = document.getElementById("btn-close-explain");
  const draftFeedbackBanner = document.getElementById("draft-feedback-banner");
  const redactionSummary = document.getElementById("redaction-summary");
  const draftWarnings = document.getElementById("draft-warnings");
  const btnAddAction = document.getElementById("btn-add-action");
  const containerActions = document.getElementById("container-actions");

  narrativeInput?.addEventListener("input", () => {
    if (charCount) {
      charCount.textContent = String(narrativeInput.value.length);
    }
  });

  // Client-side Web Speech API dictation
  let recognition: any = null;
  let isRecording = false;

  const SpeechRecognition =
    (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

  if (SpeechRecognition && btnDictate) {
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = "es-PE";

    recognition.onresult = (event: any) => {
      let finalTranscript = "";
      for (let i = event.resultIndex; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript;
        }
      }
      if (finalTranscript && narrativeInput) {
        narrativeInput.value = (narrativeInput.value ? narrativeInput.value + " " : "") + finalTranscript;
        if (charCount) charCount.textContent = String(narrativeInput.value.length);
      }
    };

    recognition.onerror = () => {
      stopDictation();
    };

    recognition.onend = () => {
      stopDictation();
    };

    btnDictate.addEventListener("click", () => {
      if (isRecording) {
        stopDictation();
      } else {
        startDictation();
      }
    });
  } else if (btnDictate) {
    btnDictate.title = "Reconocimiento de voz no soportado en este navegador";
  }

  function startDictation() {
    if (!recognition) return;
    try {
      recognition.start();
      isRecording = true;
      iconMic?.classList.add("hidden");
      iconMicOff?.classList.remove("hidden");
      if (labelDictate) labelDictate.textContent = "Detener dictado";
      speechIndicator?.classList.remove("hidden");
    } catch (e) {
      console.error(e);
    }
  }

  function stopDictation() {
    if (!recognition) return;
    try {
      recognition.stop();
    } catch {}
    isRecording = false;
    iconMic?.classList.remove("hidden");
    iconMicOff?.classList.add("hidden");
    if (labelDictate) labelDictate.textContent = "Dictar por voz";
    speechIndicator?.classList.add("hidden");
  }

  // Dynamic Action items helper
  let actionCounter = 0;

  function addActionCard(initialData?: { action_type?: string; responsible?: string; action_date?: string; description?: string; evidence?: string }) {
    if (!containerActions) return;
    actionCounter += 1;
    const actionId = `action-row-${actionCounter}`;
    const card = document.createElement("div");
    card.id = actionId;
    card.className = "action-card p-4 rounded-lg bg-slate-950 border border-slate-800 space-y-3 relative";

    const defaultDate = initialData?.action_date || new Date().toISOString().slice(0, 10);

    card.innerHTML = `
      <div class="flex items-center justify-between pb-2 border-b border-slate-800">
        <span class="text-xs font-semibold text-slate-300">Acción #${actionCounter}</span>
        <button type="button" class="btn-remove-action text-slate-500 hover:text-rose-400 transition-colors" data-target="${actionId}" title="Eliminar acción">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Tipo de acción *</label>
          <select class="action-type w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200">
            <option value="C" ${initialData?.action_type === "C" ? "selected" : ""}>Contención</option>
            <option value="A" ${initialData?.action_type === "A" ? "selected" : ""}>Análisis</option>
            <option value="R" ${initialData?.action_type === "R" ? "selected" : ""}>Resolución</option>
          </select>
        </div>
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Responsable *</label>
          <input type="text" class="action-responsible w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" placeholder="Ej. analista-seguridad" value="${initialData?.responsible || ""}" />
        </div>
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Fecha *</label>
          <input type="date" class="action-date w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" value="${defaultDate}" />
        </div>
        <div class="sm:col-span-3">
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Descripción de la acción *</label>
          <textarea rows="2" class="action-description w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-200" placeholder="Detalle de la medida ejecutada...">${initialData?.description || ""}</textarea>
        </div>
        <div class="sm:col-span-3">
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Evidencia (opcional)</label>
          <input type="text" class="action-evidence w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" placeholder="Hash, ID de log, enlace o captura..." value="${initialData?.evidence || ""}" />
        </div>
      </div>
    `;

    card.querySelector(".btn-remove-action")?.addEventListener("click", () => {
      card.remove();
    });

    containerActions.appendChild(card);
  }

  btnAddAction?.addEventListener("click", () => {
    addActionCard();
  });

  // Draft with AI
  btnDraftAi?.addEventListener("click", async () => {
    const narrative = narrativeInput?.value.trim() ?? "";
    const formData = new FormData(incidentForm);
    const partial: Record<string, any> = {};
    formData.forEach((value, key) => {
      if (key !== "affected_data_types" && key !== "affected_cid" && key !== "security_measures_adopted" && value) {
        partial[key] = value;
      }
    });

    btnDraftAi.setAttribute("disabled", "true");
    btnDraftAi.innerHTML = `<span>Procesando...</span>`;

    try {
      const response = await authenticatedFetch("/api/incidents/draft", {
        method: "POST",
        body: JSON.stringify({ narrative, partial }),
      });

      if (!response.ok) {
        const errorData = await response.json();
        alert(`Error al redactar: ${errorData.message || errorData.error}`);
        return;
      }

      const result = await response.json();
      applyDraft(result.draft, result.provenance);

      if (draftFeedbackBanner && redactionSummary && draftWarnings) {
        draftFeedbackBanner.classList.remove("hidden");
        draftFeedbackBanner.className = "p-3.5 rounded-xl border text-xs space-y-1.5 bg-blue-950/40 border-blue-800/80 text-blue-200 shadow-sm";
        
        const aiFilledCount = Object.entries(result.provenance).filter(([k, p]) => p === "narrative" && result.draft[k] !== null && result.draft[k] !== "" && (!Array.isArray(result.draft[k]) || result.draft[k].length > 0)).length;
        
        redactionSummary.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-semibold text-sm">✨ Análisis completado con éxito</span>
            <span class="text-blue-300">— Se autocompletaron ${aiFilledCount} campos a partir de su narrativa.</span>
          </div>
          <div class="text-[11px] text-slate-300 mt-1">
            <strong>Protección de privacidad:</strong> ${result.redaction_report.total_spans} datos identificatorios fueron anonimizados para la consulta de IA y restaurados fielmente en el formulario para su validación.
          </div>
        `;

        draftWarnings.innerHTML = "";
        if (result.warnings && result.warnings.length > 0) {
          result.warnings.forEach((warn: string) => {
            const p = document.createElement("p");
            p.textContent = `• ${warn}`;
            draftWarnings.appendChild(p);
          });
        }
      }
    } catch (error) {
      alert("Error de red al consultar el asistente.");
    } finally {
      btnDraftAi.removeAttribute("disabled");
      btnDraftAi.innerHTML = `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg><span>Analizar y autocompletar formulario con IA</span>`;
    }
  });

  function applyDraft(draft: any, provenance: Record<string, string>) {
    for (const [key, val] of Object.entries(draft)) {
      const input = document.getElementById(`field-${key}`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (input && val !== null && val !== undefined) {
        input.value = String(val);
      }

      if (key === "involves_personal_data") {
        const radios = document.getElementsByName("involves_personal_data") as NodeListOf<HTMLInputElement>;
        radios.forEach((r) => {
          r.checked = (r.value === "true" && val === true) || (r.value === "false" && val === false);
        });
      }

      if (key === "affected_cid" && Array.isArray(val)) {
        const checkboxes = document.getElementsByName("affected_cid") as NodeListOf<HTMLInputElement>;
        checkboxes.forEach((cb) => {
          cb.checked = val.includes(cb.value);
        });
      }

      if (key === "affected_data_types" && Array.isArray(val)) {
        const checkboxes = document.getElementsByName("affected_data_types") as NodeListOf<HTMLInputElement>;
        checkboxes.forEach((cb) => {
          cb.checked = val.includes(cb.value);
        });
      }

      if (key === "security_measures_adopted" && Array.isArray(val)) {
        const checkboxes = document.getElementsByName("security_measures_adopted") as NodeListOf<HTMLInputElement>;
        checkboxes.forEach((cb) => {
          cb.checked = val.includes(cb.value);
        });
      }

      if (key === "actions" && Array.isArray(val) && val.length > 0) {
        if (containerActions && containerActions.children.length === 0) {
          val.forEach((act: any) => addActionCard(act));
        }
      }

      // Update provenance badge
      const badge = document.getElementById(`badge-${key}`);
      if (badge) {
        badge.classList.remove("hidden", "provenance-narrative", "provenance-partial", "provenance-default");
        const hasVal = val !== null && val !== undefined && val !== "" && (!Array.isArray(val) || val.length > 0);

        if (provenance[key] === "narrative" && hasVal) {
          badge.classList.remove("hidden");
          badge.classList.add("provenance-narrative");
          badge.textContent = "✨ IA";
          badge.title = "Completado automáticamente por IA a partir de la narrativa";
        } else if (provenance[key] === "default" && hasVal) {
          badge.classList.remove("hidden");
          badge.classList.add("provenance-default");
          badge.textContent = "Predeterminado";
          badge.title = "Valor institucional predeterminado";
        } else {
          // If empty, leave hidden! No confusing badges on empty fields!
          badge.classList.add("hidden");
        }
      }

      // Listen for operator modification to mark field as manually edited
      const fieldEl = document.getElementById(`field-${key}`);
      if (fieldEl) {
        fieldEl.addEventListener("input", () => {
          const b = document.getElementById(`badge-${key}`);
          if (b && !b.classList.contains("hidden")) {
            b.classList.remove("provenance-narrative", "provenance-default");
            b.classList.add("provenance-partial");
            b.textContent = "Editado";
            b.title = "Modificado manualmente por el operador";
          }
        }, { once: true });
      }
    }
  }

  // Field explain buttons
  document.querySelectorAll(".btn-explain").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const field = btn.getAttribute("data-field");
      if (!field) return;

      if (modalExplainTitle) modalExplainTitle.textContent = `Explicación técnica: ${field}`;
      if (modalExplainContent) modalExplainContent.textContent = "Consultando catálogo y normativa RAG...";
      if (modalExplainCitations) modalExplainCitations.innerHTML = "";
      modalExplain?.classList.remove("hidden");

      try {
        const res = await authenticatedFetch("/api/incidents/explain", {
          method: "POST",
          body: JSON.stringify({ field }),
        });

        if (!res.ok) {
          if (modalExplainContent) modalExplainContent.textContent = "No se pudo obtener la explicación del campo.";
          return;
        }

        const data = await res.json();
        if (data.type === "enum" && data.options) {
          let html = `<p class="mb-2 text-slate-400">${data.explanation}</p><ul class="space-y-1.5">`;
          data.options.forEach((opt: any) => {
            html += `<li class="p-2 rounded bg-slate-950 border border-slate-800"><span class="font-bold text-blue-400">${opt.code}</span> - <span class="text-white">${opt.label}</span>${opt.description ? `<p class="text-[11px] text-slate-400 mt-0.5">${opt.description}</p>` : ""}</li>`;
          });
          html += "</ul>";
          if (modalExplainContent) modalExplainContent.innerHTML = html;
        } else {
          if (modalExplainContent) modalExplainContent.textContent = data.explanation;
          if (data.citations && data.citations.length > 0 && modalExplainCitations) {
            let citHtml = "<p class='font-semibold mt-2'>Citas normativas:</p>";
            data.citations.forEach((c: any) => {
              citHtml += `<div class="p-1.5 rounded bg-blue-950/30 border border-blue-900/50 mt-1">${c.citation}: ${c.text.slice(0, 150)}...</div>`;
            });
            modalExplainCitations.innerHTML = citHtml;
          }
        }
      } catch (e) {
        if (modalExplainContent) modalExplainContent.textContent = "Error al conectar con el servicio de explicación.";
      }
    });
  });

  btnCloseExplain?.addEventListener("click", () => {
    modalExplain?.classList.add("hidden");
  });

  // Submit Incident
  incidentForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btnSubmit = document.getElementById("btn-submit-incident") as HTMLButtonElement;
    btnSubmit.setAttribute("disabled", "true");
    btnSubmit.innerHTML = `<span>Registrando incidente...</span>`;

    const formData = new FormData(incidentForm);
    const body: Record<string, any> = {};

    formData.forEach((value, key) => {
      if (key === "affected_cid" || key === "affected_data_types" || key === "security_measures_adopted") {
        if (!body[key]) body[key] = [];
        body[key].push(value);
      } else if (key === "involves_personal_data") {
        body[key] = value === "true";
      } else if (key === "num_affected_subjects") {
        body[key] = value ? Number(value) : null;
      } else {
        body[key] = value || null;
      }
    });

    if (!body.affected_cid) body.affected_cid = [];
    if (!body.affected_data_types) body.affected_data_types = [];
    if (!body.security_measures_adopted) body.security_measures_adopted = [];

    // Collect dynamic action cards (if any were added)
    const actionCards = document.querySelectorAll(".action-card");
    const actions: any[] = [];
    actionCards.forEach((card) => {
      const typeEl = card.querySelector(".action-type") as HTMLSelectElement;
      const respEl = card.querySelector(".action-responsible") as HTMLInputElement;
      const dateEl = card.querySelector(".action-date") as HTMLInputElement;
      const descEl = card.querySelector(".action-description") as HTMLTextAreaElement;
      const evidEl = card.querySelector(".action-evidence") as HTMLInputElement;

      const description = descEl?.value.trim();
      if (description) {
        actions.push({
          action_type: typeEl?.value || "C",
          responsible: respEl?.value.trim() || "operador",
          action_date: dateEl?.value || new Date().toISOString().slice(0, 10),
          description,
          evidence: evidEl?.value.trim() || null,
        });
      }
    });
    body.actions = actions;

    body.idempotency_key = `agi1:create:${crypto.randomUUID()}`;

    try {
      const response = await authenticatedFetch("/api/incidents", {
        method: "POST",
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const errorData = await response.json();
        let errorMsg = errorData.message || errorData.error;
        if (errorData.details && Array.isArray(errorData.details)) {
          errorMsg += "\n" + errorData.details.map((d: any) => `• ${d.path.join(".")}: ${d.message}`).join("\n");
        }
        alert(`Error al crear incidente:\n${errorMsg}`);
        btnSubmit.removeAttribute("disabled");
        btnSubmit.innerHTML = `<span>Registrar incidente</span>`;
        return;
      }

      const result = await response.json();
      if (result.dedupe) {
        alert(`Incidente duplicado consolidado en registro existente: ${result.incident_code}`);
      } else {
        alert(`Incidente ${result.incident_code} creado exitosamente.`);
      }
      window.location.href = "/incidents";
    } catch (err) {
      alert("Error de red al enviar el incidente.");
      btnSubmit.removeAttribute("disabled");
      btnSubmit.innerHTML = `<span>Registrar incidente</span>`;
    }
  });
</script>
