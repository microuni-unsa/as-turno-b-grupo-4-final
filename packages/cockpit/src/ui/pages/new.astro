---
import AppLayout from "@pims/cockpit/ui/layouts/AppLayout.astro";
import {
  AlertCircle,
  AlertTriangle,
  ArrowLeft,
  CheckCircle2,
  HelpCircle,
  Info,
  Plus,
  Send,
  Sparkles,
  Trash2,
  X,
} from "lucide-astro";
---

<AppLayout title="Nuevo Incidente Guiado | Glass-Box Cockpit" breadcrumb="Nuevo Incidente">
  <div class="max-w-5xl mx-auto space-y-6 pb-16">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a
          href="/incidents"
          class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-colors"
          title="Volver a lista de incidentes"
        >
          <ArrowLeft class="w-4 h-4" />
        </a>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-white flex items-center space-x-2">
            <span>Creación Guiada de Incidente</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-medium">
              Asistido por IA §8.4
            </span>
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            Formulario unificado con el PIMS primario. Puede interactuar con el Copiloto IA flotante en la esquina inferior derecha o dictar por voz para completar y ajustar los campos.
          </p>
        </div>
      </div>
    </div>

    <!-- Incident Form Sections -->
    <form id="incident-form" class="space-y-6">

      <!-- Section 1: Representante Legal (Opcional) -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div>
            <h3 class="text-sm font-semibold text-white">1. Representante Legal</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Datos del representante o persona de contacto principal ante la autoridad.</p>
          </div>
          <span class="text-[11px] font-medium text-slate-500 bg-slate-800 px-2 py-0.5 rounded">Opcional</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Número de documento</label>
              <span id="badge-rep_document_number" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_document_number"
              name="rep_document_number"
              type="text"
              placeholder="Ej. 72345678"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Caducidad del documento</label>
              <span id="badge-rep_document_expiry" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_document_expiry"
              name="rep_document_expiry"
              type="date"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Nombres</label>
              <span id="badge-rep_first_name" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_first_name"
              name="rep_first_name"
              type="text"
              placeholder="Ej. Carlos Alberto"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Cargo</label>
              <span id="badge-rep_position" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_position"
              name="rep_position"
              type="text"
              placeholder="Ej. Director de Tecnologías / DPO"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Apellido paterno</label>
              <span id="badge-rep_last_name_p" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_last_name_p"
              name="rep_last_name_p"
              type="text"
              placeholder="Ej. Mendoza"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Apellido materno</label>
              <span id="badge-rep_last_name_m" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_last_name_m"
              name="rep_last_name_m"
              type="text"
              placeholder="Ej. Quispe"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Celular</label>
              <span id="badge-rep_phone" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_phone"
              name="rep_phone"
              type="tel"
              placeholder="Ej. 987654321"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Correo electrónico</label>
              <span id="badge-rep_email" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-rep_email"
              name="rep_email"
              type="email"
              placeholder="Ej. cmendoza@unsa.edu.pe"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Section 2: Entidad Afectada (Opcional) -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div>
            <h3 class="text-sm font-semibold text-white">2. Entidad Afectada</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Identificación de la organización o institución titular del tratamiento.</p>
          </div>
          <span class="text-[11px] font-medium text-slate-500 bg-slate-800 px-2 py-0.5 rounded">Opcional</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Tipo de entidad</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="entity_type">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <select
              id="field-entity_type"
              name="entity_type"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="U">U - Pública / Universitaria</option>
              <option value="R">R - Privada</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">RUC</label>
              <span id="badge-entity_ruc" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_ruc"
              name="entity_ruc"
              type="text"
              maxlength="11"
              placeholder="11 dígitos (Ej. 20123456789)"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Nombre o razón social</label>
              <span id="badge-entity_name" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_name"
              name="entity_name"
              type="text"
              placeholder="Ej. Universidad Nacional de San Agustín"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Teléfono</label>
              <span id="badge-entity_phone" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_phone"
              name="entity_phone"
              type="tel"
              placeholder="Ej. 054-282120"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Anexo</label>
              <span id="badge-entity_extension" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_extension"
              name="entity_extension"
              type="text"
              placeholder="Ej. 104"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Departamento</label>
              <span id="badge-entity_department" class="provenance-badge hidden"></span>
            </div>
            <select
              id="field-entity_department"
              name="entity_department"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="Arequipa">Arequipa</option>
              <option value="Lima">Lima</option>
              <option value="Cusco">Cusco</option>
              <option value="Áncash">Áncash</option>
              <option value="Apurímac">Apurímac</option>
              <option value="Ayacucho">Ayacucho</option>
              <option value="Cajamarca">Cajamarca</option>
              <option value="Callao">Callao</option>
              <option value="Huancavelica">Huancavelica</option>
              <option value="Huánuco">Huánuco</option>
              <option value="Ica">Ica</option>
              <option value="Junín">Junín</option>
              <option value="La Libertad">La Libertad</option>
              <option value="Lambayeque">Lambayeque</option>
              <option value="Loreto">Loreto</option>
              <option value="Madre de Dios">Madre de Dios</option>
              <option value="Moquegua">Moquegua</option>
              <option value="Pasco">Pasco</option>
              <option value="Piura">Piura</option>
              <option value="Puno">Puno</option>
              <option value="San Martín">San Martín</option>
              <option value="Tacna">Tacna</option>
              <option value="Tumbes">Tumbes</option>
              <option value="Ucayali">Ucayali</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Provincia</label>
              <span id="badge-entity_province" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_province"
              name="entity_province"
              type="text"
              placeholder="Ej. Arequipa"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Distrito</label>
              <span id="badge-entity_district" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-entity_district"
              name="entity_district"
              type="text"
              placeholder="Ej. Arequipa"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Section 3: Detalles del Incidente (Obligatorio / Clasificación) -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div>
            <h3 class="text-sm font-semibold text-white">3. Información General del Incidente</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Clasificación operativa, línea de tiempo y descripción de los hechos.</p>
          </div>
          <span class="text-[11px] font-medium text-rose-400 bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 rounded">Obligatorio</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-medium text-slate-400 block mb-1">Código de incidente</label>
            <input
              type="text"
              disabled
              value="(se genera al guardar)"
              class="w-full bg-slate-950/60 border border-slate-800/80 rounded-lg px-3 py-2 text-xs text-slate-500 cursor-not-allowed"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                ¿Involucra datos personales? <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-involves_personal_data" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="involves_personal_data">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <div class="flex items-center space-x-4 h-9">
              <label class="flex items-center space-x-2 text-xs text-slate-200 cursor-pointer">
                <input type="radio" name="involves_personal_data" value="true" required class="text-blue-600 focus:ring-0" />
                <span>Sí (Brecha de Datos)</span>
              </label>
              <label class="flex items-center space-x-2 text-xs text-slate-200 cursor-pointer">
                <input type="radio" name="involves_personal_data" value="false" required class="text-blue-600 focus:ring-0" />
                <span>No (Incidente de Seguridad)</span>
              </label>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Fecha del incidente *
              </label>
              <span id="badge-incident_date" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-incident_date"
              name="incident_date"
              type="date"
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Hora del incidente</label>
              <span id="badge-incident_time" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-incident_time"
              name="incident_time"
              type="time"
              step="1"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Fecha de detección</label>
              <span id="badge-detection_date" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-detection_date"
              name="detection_date"
              type="date"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Hora de detección</label>
              <span id="badge-detection_time" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-detection_time"
              name="detection_time"
              type="time"
              step="1"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Tipo de incidente <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-incident_type" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="incident_type">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <select
              id="field-incident_type"
              name="incident_type"
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="UA">UA - Acceso no autorizado</option>
              <option value="DL">DL - Fuga o pérdida de datos</option>
              <option value="MW">MW - Malware o ransomware</option>
              <option value="PH">PH - Phishing o ingeniería social</option>
              <option value="DS">DS - Denegación de servicio</option>
              <option value="HE">HE - Error humano</option>
              <option value="DV">DV - Robo o pérdida de dispositivo</option>
              <option value="OT">OT - Otro</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Estado inicial</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="status">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <select
              id="field-status"
              name="status"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="O" selected>Abierto (O)</option>
              <option value="P">En proceso (P)</option>
              <option value="C">Cerrado (C)</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Severidad</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="severity">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <select
              id="field-severity"
              name="severity"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="">— Sin especificar (evaluado en triaje)</option>
              <option value="L">L - Baja</option>
              <option value="M">M - Media</option>
              <option value="H">H - Alta</option>
              <option value="C">C - Crítica</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Impacto</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="impact">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <select
              id="field-impact"
              name="impact"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="">— Sin especificar (evaluado en triaje)</option>
              <option value="L">L - Bajo</option>
              <option value="M">M - Medio</option>
              <option value="H">H - Alto</option>
              <option value="V">V - Muy alto</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Título del incidente <span class="text-rose-400">*</span>
              </label>
              <span id="badge-title" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-title"
              name="title"
              type="text"
              required
              maxlength="150"
              placeholder="Ej. Filtración de registros en portal de admisiones"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div class="sm:col-span-2">
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Descripción detallada</label>
              <span id="badge-description" class="provenance-badge hidden"></span>
            </div>
            <textarea
              id="field-description"
              name="description"
              rows="3"
              maxlength="1000"
              placeholder="Detalles sobre lo ocurrido, sistemas afectados y consecuencias observadas..."
              class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            ></textarea>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Reportado por</label>
              <span id="badge-reported_by" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-reported_by"
              name="reported_by"
              type="text"
              placeholder="Operador o sistema reportante"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
