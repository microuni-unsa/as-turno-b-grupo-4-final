      </div>
      <div id="modal-explain-content" class="text-xs text-slate-300 space-y-2"></div>
      <div id="modal-explain-citations" class="text-[11px] text-blue-400 space-y-1"></div>
    </div>
  </div>
</AppLayout>

<style>
  .provenance-badge {
    font-size: 10px;
    line-height: 1rem;
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    border-width: 1px;
    border-style: solid;
  }
  .provenance-narrative {
    background-color: rgba(59, 130, 246, 0.15);
    color: rgb(147, 197, 253);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .provenance-partial {
    background-color: rgba(245, 158, 11, 0.15);
    color: rgb(252, 211, 77);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .provenance-default {
    background-color: rgba(51, 65, 85, 0.5);
    color: rgb(203, 213, 225);
    border-color: rgb(71, 85, 105);
  }

  .field-updated-highlight {
    outline: 2px solid #3b82f6 !important;
    background-color: rgba(30, 58, 138, 0.2) !important;
    transition: all 0.5s ease-out;
  }
  .field-highlight-pulse {
    animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) 2;
  }
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }
</style>

<script>
  import { authenticatedFetch } from "@pims/cockpit/ui/lib/api.ts";
  import {
    applyFormMutationToDom,
    extractCurrentFormValues,
    loadFormDraft,
    saveFormDraft,
  } from "@pims/cockpit/ui/lib/form-draft-bus.ts";
  import { ChatStore } from "@pims/cockpit/ui/lib/chat-store.ts";
  import type { ChatFormMutation } from "@pims/types/cockpit.ts";

  const incidentForm = document.getElementById("incident-form") as HTMLFormElement | null;
  const modalExplain = document.getElementById("modal-explain");
  const modalExplainTitle = document.getElementById("modal-explain-title");
  const modalExplainContent = document.getElementById("modal-explain-content");
  const modalExplainCitations = document.getElementById("modal-explain-citations");
  const btnCloseExplain = document.getElementById("btn-close-explain");
  const btnAddAction = document.getElementById("btn-add-action");
  const containerActions = document.getElementById("container-actions");

  // Dynamic Action items helper
  let actionCounter = 0;

  function addActionCard(initialData?: {
    action_type?: string;
    responsible?: string;
    action_date?: string;
    description?: string;
    evidence?: string | null;
  }) {
    if (!containerActions) return;
    actionCounter += 1;
    const actionId = `action-row-${actionCounter}`;
    const card = document.createElement("div");
    card.id = actionId;
    card.className =
      "action-card p-4 rounded-lg bg-slate-950 border border-slate-800 space-y-3 relative";

    const defaultDate =
      initialData?.action_date || new Date().toISOString().slice(0, 10);

    card.innerHTML = `
      <div class="flex items-center justify-between pb-2 border-b border-slate-800">
        <span class="text-xs font-semibold text-slate-300">Acción #${actionCounter}</span>
        <button type="button" class="btn-remove-action text-slate-500 hover:text-rose-400 transition-colors" data-target="${actionId}" title="Eliminar acción">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Tipo de acción *</label>
          <select class="action-type w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200">
            <option value="C" ${initialData?.action_type === "C" ? "selected" : ""}>Contención</option>
            <option value="A" ${initialData?.action_type === "A" ? "selected" : ""}>Análisis</option>
            <option value="R" ${initialData?.action_type === "R" ? "selected" : ""}>Resolución</option>
          </select>
        </div>
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Responsable *</label>
          <input type="text" class="action-responsible w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" placeholder="Ej. analista-seguridad" value="${initialData?.responsible || ""}" />
        </div>
        <div>
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Fecha *</label>
          <input type="date" class="action-date w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" value="${defaultDate}" />
        </div>
        <div class="sm:col-span-3">
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Descripción de la acción *</label>
          <textarea rows="2" class="action-description w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-200" placeholder="Detalle de la medida ejecutada...">${initialData?.description || ""}</textarea>
        </div>
        <div class="sm:col-span-3">
          <label class="text-[11px] font-medium text-slate-400 block mb-1">Evidencia (opcional)</label>
          <input type="text" class="action-evidence w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200" placeholder="Hash, ID de log, enlace o captura..." value="${initialData?.evidence || ""}" />
        </div>
      </div>
    `;

    card.querySelector(".btn-remove-action")?.addEventListener("click", () => {
      card.remove();
      saveCurrentForm();
    });

    card.querySelectorAll("input, select, textarea").forEach((el) => {
      el.addEventListener("input", saveCurrentForm);
      el.addEventListener("change", saveCurrentForm);
    });

    containerActions.appendChild(card);
  }

  btnAddAction?.addEventListener("click", () => {
    addActionCard();
    saveCurrentForm();
  });

  function saveCurrentForm(): void {
    if (!incidentForm) return;
    const values = extractCurrentFormValues(incidentForm);
    saveFormDraft(values);
  }

  function initPage(): void {
    if (!incidentForm) return;

    // 1. URL search params check
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session");
    if (sessionId) {
      const store = new ChatStore();
      store.setActiveSession(sessionId);
    }

    // 2. Saved draft check
    const draft = loadFormDraft();
    if (draft && Object.keys(draft).length > 0) {
      applyFormMutationToDom({ fields: draft }, incidentForm);
      if (
        Array.isArray(draft.actions) &&
        draft.actions.length > 0 &&
        containerActions &&
        containerActions.children.length === 0
      ) {
        for (const act of draft.actions) {
          addActionCard(act);
        }
      }
    }

    // 3. Mark manual edits on badges and auto-save on change
    incidentForm.querySelectorAll("input, select, textarea").forEach((el) => {
      el.addEventListener("input", () => {
        const name =
          (el as HTMLInputElement).name ||
          (el.id ? el.id.replace(/^field-/, "") : "");
        if (name) {
          const badge = document.getElementById(`badge-${name}`);
          if (badge && !badge.classList.contains("hidden")) {
            badge.classList.remove("provenance-narrative", "provenance-default");
            badge.classList.add("provenance-partial");
            badge.textContent = "Editado";
            badge.title = "Modificado manualmente por el operador";
          }
        }
        saveCurrentForm();
      });
      el.addEventListener("change", saveCurrentForm);
    });
  }

  // 4. Listen to cockpit:form-updated on window and sync
  let isUpdatingFromEvent = false;
  window.addEventListener("cockpit:form-updated", ((
    e: CustomEvent<{ mutation?: ChatFormMutation }>,
  ) => {
    if (!incidentForm || isUpdatingFromEvent) return;
    const mutation = e.detail?.mutation;
    if (mutation) {
      isUpdatingFromEvent = true;
      try {
        applyFormMutationToDom(mutation, incidentForm);
        if (
          Array.isArray(mutation.fields?.actions) &&
          mutation.fields.actions.length > 0 &&
          containerActions &&
          containerActions.children.length === 0
        ) {
          for (const act of mutation.fields.actions) {
            addActionCard(act);
          }
        }
        saveCurrentForm();
      } finally {
        isUpdatingFromEvent = false;
      }
    }
  }) as EventListener);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }
  document.addEventListener("astro:page-load", initPage);

  // Field explain buttons
  document.querySelectorAll(".btn-explain").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const field = btn.getAttribute("data-field");
      if (!field) return;

      if (modalExplainTitle)
        modalExplainTitle.textContent = `Explicación técnica: ${field}`;
      if (modalExplainContent)
        modalExplainContent.textContent = "Consultando catálogo y normativa RAG...";
      if (modalExplainCitations) modalExplainCitations.innerHTML = "";
      modalExplain?.classList.remove("hidden");

      try {
        const res = await authenticatedFetch("/api/incidents/explain", {
          method: "POST",
          body: JSON.stringify({ field }),
        });

        if (!res.ok) {
          if (modalExplainContent)
            modalExplainContent.textContent =
              "No se pudo obtener la explicación del campo.";
          return;
        }

        const data = await res.json();
        if (data.type === "enum" && data.options) {
          let html = `<p class="mb-2 text-slate-400">${data.explanation}</p><ul class="space-y-1.5">`;
          data.options.forEach((opt: any) => {
            html += `<li class="p-2 rounded bg-slate-950 border border-slate-800"><span class="font-bold text-blue-400">${opt.code}</span> - <span class="text-white">${opt.label}</span>${opt.description ? `<p class="text-[11px] text-slate-400 mt-0.5">${opt.description}</p>` : ""}</li>`;
          });
          html += "</ul>";
          if (modalExplainContent) modalExplainContent.innerHTML = html;
        } else {
          if (modalExplainContent)
            modalExplainContent.textContent = data.explanation;
          if (
            data.citations &&
            data.citations.length > 0 &&
            modalExplainCitations
          ) {
            let citHtml = "<p class='font-semibold mt-2'>Citas normativas:</p>";
            data.citations.forEach((c: any) => {
              citHtml += `<div class="p-1.5 rounded bg-blue-950/30 border border-blue-900/50 mt-1">${c.citation}: ${c.text.slice(0, 150)}...</div>`;
            });
            modalExplainCitations.innerHTML = citHtml;
          }
        }
      } catch (e) {
        if (modalExplainContent)
          modalExplainContent.textContent =
            "Error al conectar con el servicio de explicación.";
      }
    });
  });

  btnCloseExplain?.addEventListener("click", () => {
    modalExplain?.classList.add("hidden");
  });

  // Submit Incident
  incidentForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btnSubmit = document.getElementById(
      "btn-submit-incident",
    ) as HTMLButtonElement;
    btnSubmit.setAttribute("disabled", "true");
    btnSubmit.innerHTML = `<span>Registrando incidente...</span>`;

    const formData = new FormData(incidentForm);
    const body: Record<string, any> = {};

    formData.forEach((value, key) => {
      if (
        key === "affected_cid" ||
        key === "affected_data_types" ||
        key === "security_measures_adopted"
      ) {
        if (!body[key]) body[key] = [];
        body[key].push(value);
      } else if (key === "involves_personal_data") {
        body[key] = value === "true";
      } else if (key === "num_affected_subjects") {
        body[key] = value ? Number(value) : null;
      } else {
        body[key] = value || null;
      }
    });

    if (!body.affected_cid) body.affected_cid = [];
    if (!body.affected_data_types) body.affected_data_types = [];
    if (!body.security_measures_adopted) body.security_measures_adopted = [];

    // Collect dynamic action cards (if any were added)
    const actionCards = document.querySelectorAll(".action-card");
    const actions: any[] = [];
    actionCards.forEach((card) => {
      const typeEl = card.querySelector(".action-type") as HTMLSelectElement;
      const respEl = card.querySelector(
        ".action-responsible",
      ) as HTMLInputElement;
      const dateEl = card.querySelector(".action-date") as HTMLInputElement;
      const descEl = card.querySelector(
        ".action-description",
      ) as HTMLTextAreaElement;
      const evidEl = card.querySelector(".action-evidence") as HTMLInputElement;

      const description = descEl?.value.trim();
      if (description) {
        actions.push({
          action_type: typeEl?.value || "C",
          responsible: respEl?.value.trim() || "operador",
          action_date: dateEl?.value || new Date().toISOString().slice(0, 10),
          description,
          evidence: evidEl?.value.trim() || null,
        });
      }
    });
    body.actions = actions;

    body.idempotency_key = `agi1:create:${crypto.randomUUID()}`;

    try {
      const response = await authenticatedFetch("/api/incidents", {
        method: "POST",
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const errorData = await response.json();
        let errorMsg = errorData.message || errorData.error;
        if (errorData.details && Array.isArray(errorData.details)) {
          errorMsg +=
            "\n" +
            errorData.details
              .map((d: any) => `• ${d.path.join(".")}: ${d.message}`)
              .join("\n");
        }
        alert(`Error al crear incidente:\n${errorMsg}`);
        btnSubmit.removeAttribute("disabled");
        btnSubmit.innerHTML = `<span>Registrar incidente</span>`;
        return;
      }

      const result = await response.json();
      if (result.dedupe) {
        alert(
          `Incidente duplicado consolidado en registro existente: ${result.incident_code}`,
        );
      } else {
        alert(`Incidente ${result.incident_code} creado exitosamente.`);
      }
      window.location.href = "/incidents";
    } catch (err) {
      alert("Error de red al enviar el incidente.");
      btnSubmit.removeAttribute("disabled");
      btnSubmit.innerHTML = `<span>Registrar incidente</span>`;
    }
  });
</script>
