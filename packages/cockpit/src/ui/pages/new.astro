---
import AppLayout from "@pims/cockpit/ui/layouts/AppLayout.astro";
import {
  AlertCircle,
  AlertTriangle,
  ArrowLeft,
  CheckCircle2,
  HelpCircle,
  Mic,
  MicOff,
  Send,
  Sparkles,
  X,
} from "lucide-astro";
---

<AppLayout title="Nuevo Incidente Guiado | Glass-Box Cockpit" breadcrumb="Nuevo Incidente">
  <div class="max-w-5xl mx-auto space-y-6 pb-12">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a
          href="/incidents"
          class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-colors"
          title="Volver a lista de incidentes"
        >
          <ArrowLeft class="w-4 h-4" />
        </a>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-white flex items-center space-x-2">
            <span>Creación Guiada de Incidente</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-medium">
              Asistido por IA §8.4
            </span>
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            Redacte el incidente con asistencia de IA o dictado por voz. Revise y valide cada campo antes de enviar.
          </p>
        </div>
      </div>
    </div>

    <!-- AI Drafting & Dictation Section -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <Sparkles class="w-4 h-4 text-blue-400" />
          <h2 class="text-sm font-semibold text-white">Narrativa libre o dictada</h2>
        </div>
        <div class="flex items-center space-x-2">
          <button
            id="btn-dictate"
            type="button"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors flex items-center space-x-1.5 border border-slate-700"
          >
            <Mic id="icon-mic" class="w-3.5 h-3.5 text-rose-400" />
            <MicOff id="icon-mic-off" class="w-3.5 h-3.5 text-slate-400 hidden" />
            <span id="label-dictate">Dictar por voz</span>
          </button>
          <button
            id="btn-draft-ai"
            type="button"
            class="px-4 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium transition-colors flex items-center space-x-1.5 shadow-sm"
          >
            <Sparkles class="w-3.5 h-3.5" />
            <span>Redactar borrador con IA</span>
          </button>
        </div>
      </div>

      <div class="relative">
        <textarea
          id="input-narrative"
          rows="4"
          maxlength="4000"
          placeholder="Describa el incidente con sus propias palabras o utilice el botón de dictado (ej. 'El día de hoy a las 09:30 detectamos una filtración de registros de postulantes en el portal de admisiones debido a una credencial comprometida. Afectó a unos 500 postulantes con DNI y correos...')"
          class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-slate-200 placeholder:text-slate-600 focus:border-blue-500 focus:outline-none resize-y"
        ></textarea>
        <div class="flex justify-between items-center text-[10px] text-slate-500 mt-1 px-1">
          <span id="speech-indicator" class="hidden text-amber-400 animate-pulse">Escuchando micrófono (Web Speech API)...</span>
          <span class="ml-auto tabular-nums"><span id="char-count">0</span> / 4000 caracteres</span>
        </div>
      </div>

      <!-- Redaction Report & Warnings Banner -->
      <div id="draft-feedback-banner" class="hidden p-3 rounded-lg border text-xs space-y-1.5">
        <div id="redaction-summary" class="font-medium"></div>
        <div id="draft-warnings" class="space-y-0.5 text-amber-300"></div>
      </div>
    </div>

    <!-- Incident Form Form Sections -->
    <form id="incident-form" class="space-y-6">
      <!-- Section 1: Identificación -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <h3 class="text-sm font-semibold text-white border-b border-slate-800 pb-2">1. Identificación del Incidente</h3>
        <div class="grid grid-cols-1 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Título del incidente <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-title" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="title">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <input
              id="field-title"
              name="title"
              type="text"
              required
              maxlength="150"
              placeholder="Ej. Filtración de registros en portal de admisiones"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Descripción detallada</label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-description" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="description">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <textarea
              id="field-description"
              name="description"
              rows="3"
              maxlength="1000"
              placeholder="Detalles sobre lo ocurrido, sistemas y consecuencias observadas..."
              class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Section 2: Línea de tiempo -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <h3 class="text-sm font-semibold text-white border-b border-slate-800 pb-2">2. Línea de Tiempo</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Fecha del incidente (ocurrencia) <span class="text-rose-400">*</span>
              </label>
              <span id="badge-incident_date" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-incident_date"
              name="incident_date"
              type="date"
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Hora del incidente</label>
              <span id="badge-incident_time" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-incident_time"
              name="incident_time"
              type="time"
              step="1"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Fecha de detección <span class="text-rose-400">*</span>
              </label>
              <span id="badge-detection_date" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-detection_date"
              name="detection_date"
              type="date"
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Hora de detección</label>
              <span id="badge-detection_time" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-detection_time"
              name="detection_time"
              type="time"
              step="1"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Section 3: Clasificación y Alcance -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <h3 class="text-sm font-semibold text-white border-b border-slate-800 pb-2">3. Clasificación y Alcance</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                Tipo de incidente (provisional) <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-incident_type" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="incident_type">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <select
              id="field-incident_type"
              name="incident_type"
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            >
              <option value="UA">UA - Acceso no autorizado</option>
              <option value="DL">DL - Fuga o pérdida de datos</option>
              <option value="MW">MW - Malware o ransomware</option>
              <option value="PH">PH - Phishing o ingeniería social</option>
              <option value="DS">DS - Denegación de servicio</option>
              <option value="HE">HE - Error humano</option>
              <option value="DV">DV - Robo o pérdida de dispositivo</option>
              <option value="OT">OT - Otro</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">
                ¿Involucra datos personales? <span class="text-rose-400">*</span>
              </label>
              <div class="flex items-center space-x-1.5">
                <span id="badge-involves_personal_data" class="provenance-badge hidden"></span>
                <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="involves_personal_data">
                  <HelpCircle class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
            <div class="flex items-center space-x-4 h-9">
              <label class="flex items-center space-x-2 text-xs text-slate-200 cursor-pointer">
                <input type="radio" name="involves_personal_data" value="true" required class="text-blue-600 focus:ring-0" />
                <span>Sí (Brecha de Datos)</span>
              </label>
              <label class="flex items-center space-x-2 text-xs text-slate-200 cursor-pointer">
                <input type="radio" name="involves_personal_data" value="false" required class="text-blue-600 focus:ring-0" />
                <span>No (Incidente de Seguridad)</span>
              </label>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Sistema comprometido</label>
              <span id="badge-compromised_system" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-compromised_system"
              name="compromised_system"
              type="text"
              placeholder="Ej. portal-admisiones.unsa.edu.pe"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">Número de titulares afectados (est.)</label>
              <span id="badge-num_affected_subjects" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-num_affected_subjects"
              name="num_affected_subjects"
              type="number"
              min="0"
              placeholder="Ej. 500"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <div class="sm:col-span-2">
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-medium text-slate-300">URL afectada</label>
              <span id="badge-affected_url" class="provenance-badge hidden"></span>
            </div>
            <input
              id="field-affected_url"
              name="affected_url"
              type="url"
              placeholder="https://admissions.unsa.edu.pe"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-blue-500 focus:outline-none"
            />
          </div>

          <!-- Dimensiones CID -->
          <div class="sm:col-span-2">
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-xs font-medium text-slate-300">Impacto en dimensiones de seguridad (CID)</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="affected_cid">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <div class="flex flex-wrap gap-4 bg-slate-950 p-2.5 rounded-lg border border-slate-800">
              <label class="flex items-center space-x-1.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" name="affected_cid" value="C" class="rounded text-blue-600 focus:ring-0" />
                <span>Confidencialidad (C)</span>
              </label>
              <label class="flex items-center space-x-1.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" name="affected_cid" value="I" class="rounded text-blue-600 focus:ring-0" />
                <span>Integridad (I)</span>
              </label>
              <label class="flex items-center space-x-1.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" name="affected_cid" value="D" class="rounded text-blue-600 focus:ring-0" />
                <span>Disponibilidad (D)</span>
              </label>
            </div>
          </div>

          <!-- Tipos de datos afectados -->
          <div class="sm:col-span-2">
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-xs font-medium text-slate-300">Tipos de datos afectados</label>
              <button type="button" class="btn-explain text-slate-400 hover:text-blue-400" data-field="affected_data_types">
                <HelpCircle class="w-3.5 h-3.5" />
              </button>
            </div>
            <div id="container-data-types" class="grid grid-cols-2 sm:grid-cols-3 gap-2 bg-slate-950 p-2.5 rounded-lg border border-slate-800 text-xs text-slate-300">
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="names" /><span>Nombres y apellidos</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="id_doc" /><span>Documentos identidad</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="address" /><span>Dirección domiciliaria</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="phone" /><span>Teléfono / Celular</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="email" /><span>Correo electrónico</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="financial" /><span>Datos financieros</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="health" /><span>Datos de salud</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="biometric" /><span>Datos biométricos</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="credentials" /><span>Credenciales / Claves</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="geolocation" /><span>Geolocalización</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="minors" /><span>Menores de edad</span></label>
              <label class="flex items-center space-x-1.5"><input type="checkbox" name="affected_data_types" value="sensitive" /><span>Datos sensibles</span></label>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4: Reportante -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <h3 class="text-sm font-semibold text-white border-b border-slate-800 pb-2">4. Datos del Reportante</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">DNI / Documento</label>
            <input id="field-rep_document_number" name="rep_document_number" type="text" placeholder="8 dígitos" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">Nombres</label>
            <input id="field-rep_first_name" name="rep_first_name" type="text" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">Apellido Paterno</label>
            <input id="field-rep_last_name_p" name="rep_last_name_p" type="text" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">Correo electrónico</label>
            <input id="field-rep_email" name="rep_email" type="email" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">Teléfono</label>
            <input id="field-rep_phone" name="rep_phone" type="tel" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-300 mb-1 block">Cargo / Rol</label>
            <input id="field-rep_position" name="rep_position" type="text" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200" />
          </div>
        </div>
      </div>

      <!-- Submit Section -->
      <div class="flex items-center justify-between pt-4">
        <a
          href="/incidents"
          class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition-colors"
        >
          Cancelar
        </a>
        <button
          id="btn-submit-incident"
          type="submit"
          class="px-6 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium transition-colors flex items-center space-x-2 shadow-sm"
        >
          <Send class="w-4 h-4" />
          <span>Confirmar y Enviar Incidente (Estado O)</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Explain Popover Modal -->
  <div id="modal-explain" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl max-w-lg w-full p-5 shadow-xl space-y-3">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h3 id="modal-explain-title" class="text-sm font-semibold text-white"></h3>
        <button id="btn-close-explain" type="button" class="text-slate-400 hover:text-white">
          <X class="w-4 h-4" />
        </button>
      </div>
      <div id="modal-explain-content" class="text-xs text-slate-300 space-y-2"></div>
      <div id="modal-explain-citations" class="text-[11px] text-blue-400 space-y-1"></div>
    </div>
  </div>
</AppLayout>

<style>
  .provenance-badge {
    font-size: 10px;
    line-height: 1rem;
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    border-width: 1px;
    border-style: solid;
  }
  .provenance-narrative {
    background-color: rgba(59, 130, 246, 0.1);
    color: rgb(96, 165, 250);
    border-color: rgba(59, 130, 246, 0.2);
  }
  .provenance-partial {
    background-color: rgba(245, 158, 11, 0.1);
    color: rgb(251, 191, 36);
    border-color: rgba(245, 158, 11, 0.2);
  }
  .provenance-default {
    background-color: rgb(30, 41, 59);
    color: rgb(148, 163, 184);
    border-color: rgb(51, 65, 85);
  }
</style>

<script>
  import { authenticatedFetch } from "@pims/cockpit/ui/lib/api.ts";

  const narrativeInput = document.getElementById("input-narrative") as HTMLTextAreaElement;
  const charCount = document.getElementById("char-count");
  const btnDictate = document.getElementById("btn-dictate");
  const iconMic = document.getElementById("icon-mic");
  const iconMicOff = document.getElementById("icon-mic-off");
  const labelDictate = document.getElementById("label-dictate");
  const speechIndicator = document.getElementById("speech-indicator");
  const btnDraftAi = document.getElementById("btn-draft-ai");
  const incidentForm = document.getElementById("incident-form") as HTMLFormElement;
  const modalExplain = document.getElementById("modal-explain");
  const modalExplainTitle = document.getElementById("modal-explain-title");
  const modalExplainContent = document.getElementById("modal-explain-content");
  const modalExplainCitations = document.getElementById("modal-explain-citations");
  const btnCloseExplain = document.getElementById("btn-close-explain");
  const draftFeedbackBanner = document.getElementById("draft-feedback-banner");
  const redactionSummary = document.getElementById("redaction-summary");
  const draftWarnings = document.getElementById("draft-warnings");

  narrativeInput?.addEventListener("input", () => {
    if (charCount) {
      charCount.textContent = String(narrativeInput.value.length);
    }
  });

  // Client-side Web Speech API dictation
  let recognition: any = null;
  let isRecording = false;

  const SpeechRecognition =
    (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

  if (SpeechRecognition && btnDictate) {
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = "es-PE";

    recognition.onresult = (event: any) => {
      let finalTranscript = "";
      for (let i = event.resultIndex; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript;
        }
      }
      if (finalTranscript && narrativeInput) {
        narrativeInput.value = (narrativeInput.value ? narrativeInput.value + " " : "") + finalTranscript;
        if (charCount) charCount.textContent = String(narrativeInput.value.length);
      }
    };

    recognition.onerror = () => {
      stopDictation();
    };

    recognition.onend = () => {
      stopDictation();
    };

    btnDictate.addEventListener("click", () => {
      if (isRecording) {
        stopDictation();
      } else {
        startDictation();
      }
    });
  } else if (btnDictate) {
    btnDictate.title = "Reconocimiento de voz no soportado en este navegador";
  }

  function startDictation() {
    if (!recognition) return;
    try {
      recognition.start();
      isRecording = true;
      iconMic?.classList.add("hidden");
      iconMicOff?.classList.remove("hidden");
      if (labelDictate) labelDictate.textContent = "Detener dictado";
      speechIndicator?.classList.remove("hidden");
    } catch (e) {
      console.error(e);
    }
  }

  function stopDictation() {
    if (!recognition) return;
    try {
      recognition.stop();
    } catch {}
    isRecording = false;
    iconMic?.classList.remove("hidden");
    iconMicOff?.classList.add("hidden");
    if (labelDictate) labelDictate.textContent = "Dictar por voz";
    speechIndicator?.classList.add("hidden");
  }

  // Draft with AI
  btnDraftAi?.addEventListener("click", async () => {
    const narrative = narrativeInput?.value.trim() ?? "";
    const formData = new FormData(incidentForm);
    const partial: Record<string, any> = {};
    formData.forEach((value, key) => {
      if (key !== "affected_data_types" && key !== "affected_cid" && value) {
        partial[key] = value;
      }
    });

    btnDraftAi.setAttribute("disabled", "true");
    btnDraftAi.innerHTML = `<span>Procesando...</span>`;

    try {
      const response = await authenticatedFetch("/api/incidents/draft", {
        method: "POST",
        body: JSON.stringify({ narrative, partial }),
      });

      if (!response.ok) {
        const errorData = await response.json();
        alert(`Error al redactar: ${errorData.message || errorData.error}`);
        return;
      }

      const result = await response.json();
      applyDraft(result.draft, result.provenance);

      if (draftFeedbackBanner && redactionSummary && draftWarnings) {
        draftFeedbackBanner.classList.remove("hidden");
        draftFeedbackBanner.className = "p-3 rounded-lg border text-xs space-y-1.5 bg-blue-950/40 border-blue-800 text-blue-200";
        redactionSummary.textContent = `Anonimización Presidio: ${result.redaction_report.total_spans} entidades detectadas (${result.redaction_report.entities_found.join(", ") || "ninguna"}).`;
        
        draftWarnings.innerHTML = "";
        if (result.warnings && result.warnings.length > 0) {
          result.warnings.forEach((warn: string) => {
            const p = document.createElement("p");
            p.textContent = `• ${warn}`;
            draftWarnings.appendChild(p);
          });
        }
      }
    } catch (error) {
      alert("Error de red al consultar el asistente.");
    } finally {
      btnDraftAi.removeAttribute("disabled");
      btnDraftAi.innerHTML = `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg><span>Redactar borrador con IA</span>`;
    }
  });

  function applyDraft(draft: any, provenance: Record<string, string>) {
    for (const [key, val] of Object.entries(draft)) {
      const input = document.getElementById(`field-${key}`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (input && val !== null && val !== undefined) {
        input.value = String(val);
      }

      if (key === "involves_personal_data") {
        const radios = document.getElementsByName("involves_personal_data") as NodeListOf<HTMLInputElement>;
        radios.forEach((r) => {
          r.checked = (r.value === "true" && val === true) || (r.value === "false" && val === false);
        });
      }

      if (key === "affected_cid" && Array.isArray(val)) {
        const checkboxes = document.getElementsByName("affected_cid") as NodeListOf<HTMLInputElement>;
        checkboxes.forEach((cb) => {
          cb.checked = val.includes(cb.value);
        });
      }

      if (key === "affected_data_types" && Array.isArray(val)) {
        const checkboxes = document.getElementsByName("affected_data_types") as NodeListOf<HTMLInputElement>;
        checkboxes.forEach((cb) => {
          cb.checked = val.includes(cb.value);
        });
      }

      // Update provenance badge
      const badge = document.getElementById(`badge-${key}`);
      if (badge && provenance[key]) {
        badge.classList.remove("hidden", "provenance-narrative", "provenance-partial", "provenance-default");
        badge.classList.add(`provenance-${provenance[key]}`);
        badge.textContent = provenance[key] === "narrative" ? "Narrativa" : provenance[key] === "partial" ? "Operador" : "Por defecto";
      }
    }
  }

  // Field explain buttons
  document.querySelectorAll(".btn-explain").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const field = btn.getAttribute("data-field");
      if (!field) return;

      if (modalExplainTitle) modalExplainTitle.textContent = `Explicación técnica: ${field}`;
      if (modalExplainContent) modalExplainContent.textContent = "Consultando catálogo y normativa RAG...";
      if (modalExplainCitations) modalExplainCitations.innerHTML = "";
      modalExplain?.classList.remove("hidden");

      try {
        const res = await authenticatedFetch("/api/incidents/explain", {
          method: "POST",
          body: JSON.stringify({ field }),
        });

        if (!res.ok) {
          if (modalExplainContent) modalExplainContent.textContent = "No se pudo obtener la explicación del campo.";
          return;
        }

        const data = await res.json();
        if (data.type === "enum" && data.options) {
          let html = `<p class="mb-2 text-slate-400">${data.explanation}</p><ul class="space-y-1.5">`;
          data.options.forEach((opt: any) => {
            html += `<li class="p-2 rounded bg-slate-950 border border-slate-800"><span class="font-bold text-blue-400">${opt.code}</span> - <span class="text-white">${opt.label}</span>${opt.description ? `<p class="text-[11px] text-slate-400 mt-0.5">${opt.description}</p>` : ""}</li>`;
          });
          html += "</ul>";
          if (modalExplainContent) modalExplainContent.innerHTML = html;
        } else {
          if (modalExplainContent) modalExplainContent.textContent = data.explanation;
          if (data.citations && data.citations.length > 0 && modalExplainCitations) {
            let citHtml = "<p class='font-semibold mt-2'>Citas normativas:</p>";
            data.citations.forEach((c: any) => {
              citHtml += `<div class="p-1.5 rounded bg-blue-950/30 border border-blue-900/50 mt-1">${c.citation}: ${c.text.slice(0, 150)}...</div>`;
            });
            modalExplainCitations.innerHTML = citHtml;
          }
        }
      } catch (e) {
        if (modalExplainContent) modalExplainContent.textContent = "Error al conectar con el servicio de explicación.";
      }
    });
  });

  btnCloseExplain?.addEventListener("click", () => {
    modalExplain?.classList.add("hidden");
  });

  // Submit Incident
  incidentForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btnSubmit = document.getElementById("btn-submit-incident") as HTMLButtonElement;
    btnSubmit.setAttribute("disabled", "true");
    btnSubmit.innerHTML = `<span>Enviando...</span>`;

    const formData = new FormData(incidentForm);
    const body: Record<string, any> = {};

    formData.forEach((value, key) => {
      if (key === "affected_cid" || key === "affected_data_types") {
        if (!body[key]) body[key] = [];
        body[key].push(value);
      } else if (key === "involves_personal_data") {
        body[key] = value === "true";
      } else if (key === "num_affected_subjects") {
        body[key] = value ? Number(value) : null;
      } else {
        body[key] = value || null;
      }
    });

    if (!body.affected_cid) body.affected_cid = [];
    if (!body.affected_data_types) body.affected_data_types = [];
    body.idempotency_key = `agi1:create:${crypto.randomUUID()}`;

    try {
      const response = await authenticatedFetch("/api/incidents", {
        method: "POST",
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const errorData = await response.json();
        let errorMsg = errorData.message || errorData.error;
        if (errorData.details && Array.isArray(errorData.details)) {
          errorMsg += "\n" + errorData.details.map((d: any) => `• ${d.path.join(".")}: ${d.message}`).join("\n");
        }
        alert(`Error al crear incidente:\n${errorMsg}`);
        btnSubmit.removeAttribute("disabled");
        btnSubmit.innerHTML = `<span>Confirmar y Enviar Incidente (Estado O)</span>`;
        return;
      }

      const result = await response.json();
      if (result.dedupe) {
        alert(`Incidente duplicado consolidado en registro existente: ${result.incident_code}`);
      } else {
        alert(`Incidente ${result.incident_code} creado exitosamente en estado O.`);
      }
      window.location.href = "/incidents";
    } catch (err) {
      alert("Error de red al enviar el incidente.");
      btnSubmit.removeAttribute("disabled");
      btnSubmit.innerHTML = `<span>Confirmar y Enviar Incidente (Estado O)</span>`;
    }
  });
</script>
