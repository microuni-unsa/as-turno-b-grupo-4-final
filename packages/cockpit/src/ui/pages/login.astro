---
import BaseLayout from "@pims/cockpit/ui/layouts/BaseLayout.astro";
import { CONSTANTS } from "@pims/types/constants.ts";
import { Lock, LogIn, Shield, User } from "lucide-astro";
---

<BaseLayout title={CONSTANTS.BRAND_TITLE_LOGIN}>
  <div class="flex items-center justify-center min-h-screen bg-slate-950 p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8 space-y-6">
      <!-- Tenant Logo & Title -->
      <div class="text-center space-y-3">
        <div class="inline-flex w-12 h-12 bg-blue-600 rounded-xl items-center justify-center font-bold text-white text-2xl tracking-wider shadow-lg shadow-blue-500/25">
          U
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-wide text-white uppercase">
            UNSA
          </h1>
          <p class="text-xs text-slate-400 font-medium">
            Gestión Integrada · Glass-Box Cockpit
          </p>
        </div>
      </div>

      <!-- Error feedback -->
      <div
        id="login-error"
        class="hidden p-3 rounded-lg text-xs font-medium bg-rose-950/70 text-rose-300 border border-rose-800/80"
      ></div>

      <!-- Info notice -->
      <div
        id="login-notice"
        class="hidden p-3 rounded-lg text-xs font-medium bg-amber-950/70 text-amber-300 border border-amber-800/80"
      ></div>

      <!-- Login Form -->
      <form id="form-login" class="space-y-4">
        <div class="space-y-1.5">
          <label for="username" class="block text-xs font-semibold text-slate-300">
            Usuario PIMS
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
              <User class="w-4 h-4" />
            </div>
            <input
              id="username"
              type="text"
              required
              autocomplete="username"
              placeholder="ej. grupob4"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-blue-500 focus:outline-none transition-colors"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="password" class="block text-xs font-semibold text-slate-300">
            Contraseña
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
              <Lock class="w-4 h-4" />
            </div>
            <input
              id="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-blue-500 focus:outline-none transition-colors"
            />
          </div>
        </div>

        <button
          id="btn-submit"
          type="submit"
          class="w-full mt-2 py-2.5 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition-all shadow-md shadow-blue-600/20 flex items-center justify-center space-x-2"
        >
          <LogIn class="w-4 h-4" />
          <span>Acceder a la Consola</span>
        </button>
      </form>

      <!-- Roles footer info -->
      <div class="pt-4 border-t border-slate-800/80 text-[11px] text-slate-500 text-center space-y-1">
        <p class="flex items-center justify-center space-x-1">
          <Shield class="w-3.5 h-3.5 text-blue-400 inline" />
          <span>Autenticación directa contra GESTITEL PIMS (E01/E04)</span>
        </p>
        <p>Mapeo automático de roles: Administrador, Operador, Editor, Lector</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { login } from "@pims/cockpit/ui/lib/api.ts";
  import { clearSession, getSession, saveSession } from "@pims/cockpit/ui/lib/session.ts";
  import { CONSTANTS } from "@pims/types/constants.ts";

  function initLoginPage() {
    const urlParams = new URLSearchParams(window.location.search);
    const noticeEl = document.getElementById("login-notice");
    const isExpired = urlParams.get("expired") === "1";
    const existingSession = getSession();

    if (isExpired) {
      clearSession();
      if (noticeEl !== null) {
        noticeEl.textContent = "Su sesión previa ha caducado. Ingrese sus credenciales para reanudar el acceso.";
        noticeEl.classList.remove("hidden");
      } else {
        throw new Error("Missing #login-notice container element");
      }
    } else if (existingSession !== null) {
      window.location.href = CONSTANTS.COCKPIT_ROUTE_INCIDENTS;
      return;
    } else {
      if (noticeEl !== null) {
        noticeEl.classList.add("hidden");
      } else {
        throw new Error("Missing #login-notice container element");
      }
    }

    const form = document.getElementById("form-login") as HTMLFormElement | null;
    const errorEl = document.getElementById("login-error");
    const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement | null;

    if (!form) {
      throw new Error("Missing #form-login element in login page");
    }
    if (!errorEl) {
      throw new Error("Missing #login-error element in login page");
    }
    if (!submitBtn) {
      throw new Error("Missing #btn-submit element in login page");
    }

    form.onsubmit = async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");
      submitBtn.setAttribute("disabled", "true");
      submitBtn.textContent = "Autenticando...";

      const usernameEl = document.getElementById("username") as HTMLInputElement | null;
      const passwordEl = document.getElementById("password") as HTMLInputElement | null;

      if (!usernameEl) {
        throw new Error("Missing #username input element");
      }
      if (!passwordEl) {
        throw new Error("Missing #password input element");
      }

      const username = usernameEl.value.trim();
      const password = passwordEl.value;

      if (username.length === 0 || password.length === 0) {
        errorEl.textContent = "Debe ingresar usuario y contraseña.";
        errorEl.classList.remove("hidden");
        submitBtn.removeAttribute("disabled");
        submitBtn.innerHTML = `<span>Acceder a la Consola</span>`;
        return;
      }

      try {
        const session = await login({ username, password });
        saveSession(session);
        window.location.href = CONSTANTS.COCKPIT_ROUTE_INCIDENTS;
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : String(err);
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      } finally {
        submitBtn.removeAttribute("disabled");
        submitBtn.innerHTML = `<span>Acceder a la Consola</span>`;
      }
    };
  }

  document.addEventListener(CONSTANTS.EVENT_ASTRO_PAGE_LOAD, initLoginPage);
  initLoginPage();
</script>
