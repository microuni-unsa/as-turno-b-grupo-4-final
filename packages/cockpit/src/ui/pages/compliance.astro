---
import AppLayout from "@pims/cockpit/ui/layouts/AppLayout.astro";
import DecisionModal from "@pims/cockpit/ui/components/DecisionModal.astro";
import RagCitation from "@pims/cockpit/ui/components/RagCitation.astro";
import TimerCard from "@pims/cockpit/ui/components/TimerCard.astro";
import {
  AlertCircle,
  BookOpen,
  CheckCircle2,
  Clock,
  FileText,
  KeyRound,
  Lock,
  RotateCcw,
  ShieldAlert,
  ShieldCheck,
} from "lucide-astro";
---

<AppLayout title="Cumplimiento DPO | UNSA" breadcrumb="Cumplimiento DPO">
  <div class="space-y-8">
    <!-- Header banner -->
    <div>
      <h1 class="text-xl font-bold tracking-tight text-white flex items-center space-x-2">
        <ShieldCheck class="w-6 h-6 text-blue-400" />
        <span>Cumplimiento Regulatorio & Puertas de Aprobación DPO</span>
      </h1>
      <p class="text-xs text-slate-400 mt-1">
        Supervisión de plazos legales, registro de exenciones y trazabilidad de cumplimiento
      </p>
    </div>

    <!-- Active Regulatory Timers Section -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5">
          <Clock class="w-4 h-4 text-amber-400" />
          <span>Plazos Regulatorios & SLAs Activos</span>
        </h2>
        <span class="text-xs text-slate-500">Actualización en tiempo real</span>
      </div>

      <div id="timers-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered dynamically from snapshot/SSE -->
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl text-center text-xs text-slate-500 col-span-full">
          <div class="w-5 h-5 border-2 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
          Cargando plazos activos...
        </div>
      </div>
    </div>

    <!-- Pending Decision Gates Section -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5">
          <ShieldAlert class="w-4 h-4 text-blue-400" />
          <span>Puertas de Decisión DPO Pendientes de Firma</span>
        </h2>
        <span id="pending-count-badge" class="px-2 py-0.5 rounded text-xs font-semibold bg-slate-800 text-slate-400">
          0 pendientes
        </span>
      </div>

      <div id="pending-decisions-container" class="space-y-3">
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl text-center text-xs text-slate-500">
          No hay decisiones regulatorias pendientes de firma humana en este momento.
        </div>
      </div>
    </div>

    <!-- Dual-Modal RAG Normative Citations Stream -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center space-x-1.5">
          <BookOpen class="w-4 h-4 text-emerald-400" />
          <span>Trazabilidad Normativa (ISO 27701, GDPR, Ley 29733)</span>
        </h2>
        <span class="text-xs text-slate-500">Citas normativas y relevancia documental</span>
      </div>

      <div id="rag-citations-container" class="space-y-3">
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl text-center text-xs text-slate-500">
          Esperando eventos de recuperación normativa...
        </div>
      </div>
    </div>
  </div>

  <DecisionModal />
</AppLayout>

<script>
  import { authenticatedFetch } from "@pims/cockpit/ui/lib/api.ts";
  import { getSession, hasPermission } from "@pims/cockpit/ui/lib/session.ts";
  import { sseClient } from "@pims/cockpit/ui/lib/sse-client.ts";
  import type { CockpitTimer, PendingDecision, StreamSnapshot } from "@pims/types/cockpit.ts";
  import type { AgentEvent } from "@pims/types/agent.ts";
  import type { RetrievalPassage } from "@pims/types/rag.ts";
  import { formatRemainingTime } from "@pims/cockpit/ui/lib/utils.ts";

  const session = getSession();
  const canChangeIncident = hasPermission(session, "change_incident");

  function getEl<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  let activeTimers: CockpitTimer[] = [];
  let pendingDecisions: PendingDecision[] = [];
  const seenPassageKeys = new Set<string>();

  function renderTimers() {
    const timersGrid = getEl<HTMLDivElement>("timers-grid");
    if (!timersGrid) return;
    if (activeTimers.length === 0) {
      timersGrid.innerHTML = `
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl text-center text-xs text-slate-500 col-span-full">
          No hay temporizadores regulatorios activos en este momento.
        </div>
      `;
      return;
    }

    timersGrid.innerHTML = activeTimers
      .map((timer) => {
        let label = timer.timer_type;
        if (timer.timer_type === "T_AUTHORITY_72H" || timer.timer_type === "T72_AUTHORITY") label = "Plazo Legal Art. 33 GDPR (72h)";
        if (timer.timer_type === "T_INTERNAL_SLA" || timer.timer_type === "T_REVIEW_SLA") label = "SLA de Revisión Interna (4h)";
        if (timer.timer_type === "T_PHASE_FOLLOWUP") label = "Seguimiento por Fases (48h)";
        if (timer.timer_type === "T_SUBJECT") label = "Notificación a Titulares Art. 34";
        if (timer.timer_type === "T_PROCESSOR") label = "Notificación a Encargados";

        const isOverdue = timer.remaining_ms <= 0;

        return `
          <div class="bg-slate-900 border ${isOverdue ? "border-rose-900/80 bg-rose-950/20" : "border-slate-800"} rounded-xl p-4 flex flex-col justify-between space-y-3 shadow-sm hover:border-slate-700 transition-colors">
            <div class="flex items-start justify-between">
              <div class="space-y-1">
                <div class="flex items-center space-x-2">
                  <span class="px-2 py-0.5 rounded text-xs font-semibold ${isOverdue ? "bg-rose-950 text-rose-300 border border-rose-800" : "bg-blue-950 text-blue-400 border border-blue-900"}">
                    ${timer.incident_code}
                  </span>
                  <span class="text-xs font-medium text-slate-300">
                    ${label}
                  </span>
                </div>
                <p class="text-xs text-slate-500">
                  Vence: ${new Date(timer.fire_at_utc).toLocaleString("es-PE")}
                </p>
              </div>
              <div class="p-2 rounded-lg ${isOverdue ? "bg-rose-950/80 text-rose-300" : "bg-slate-800 text-slate-300"}">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-800/80 flex items-baseline justify-between">
              <span class="text-xs ${isOverdue ? "text-rose-400 font-semibold" : "text-slate-400"}">
                ${isOverdue ? "Plazo vencido:" : "Tiempo restante:"}
              </span>
              <span
                data-timer-id="${timer.timer_id}"
                data-ms="${timer.remaining_ms}"
                class="text-xl font-bold font-mono tracking-tight tabular-nums ${
                  isOverdue
                    ? "text-rose-500 animate-pulse"
                    : timer.remaining_ms < 12 * 3600 * 1000
                    ? "text-amber-400"
                    : "text-emerald-400"
                }"
              >
                ${formatRemainingTime(timer.remaining_ms)}
              </span>
            </div>
          </div>
        `;
      })
      .join("");
  }

  function renderProposalHtml(prop: Record<string, any> | null | undefined, packType: string | null): string {
    if (!prop || typeof prop !== "object") {
      return `
        <div class="p-3 bg-slate-950/60 rounded-lg border border-slate-800 text-slate-500 italic text-xs">
          No hay detalles de borrador estructurado disponibles para esta puerta de decisión.
        </div>
      `;
    }

    let html = `<div class="p-4 bg-slate-950/80 rounded-lg border border-slate-800/80 space-y-3.5">`;

    html += `
      <div class="flex items-center justify-between pb-2.5 border-b border-slate-800">
        <span class="text-xs font-semibold text-slate-200">
          ${packType === "authority" ? "Propuesta Art. 33 (Notificación a la Autoridad)" : "Propuesta Art. 34 (Comunicación a Titulares)"}
        </span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-blue-950 text-blue-300 border border-blue-800">
          Borrador Validado
        </span>
      </div>
    `;

    if (prop.item_a_approx_subjects !== undefined || prop.item_a_approx_records !== undefined) {
      html += `
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="bg-slate-900/90 p-3 rounded-lg border border-slate-800">
            <span class="text-slate-400 block text-[11px] font-medium uppercase tracking-wider">Sujetos Afectados</span>
            <span class="text-base font-bold font-mono text-white mt-0.5 block tabular-nums">${prop.item_a_approx_subjects ?? "Por determinar"}</span>
          </div>
          <div class="bg-slate-900/90 p-3 rounded-lg border border-slate-800">
            <span class="text-slate-400 block text-[11px] font-medium uppercase tracking-wider">Registros Comprometidos</span>
            <span class="text-base font-bold font-mono text-white mt-0.5 block tabular-nums">${prop.item_a_approx_records ?? "Por determinar"}</span>
          </div>
        </div>
      `;
    }

    if (prop.item_c_consequences) {
      html += `
        <div class="space-y-1.5">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Consecuencias Probables (Art. 33.3.c):</span>
          <p class="text-xs text-slate-300 leading-relaxed bg-slate-900/60 p-3 rounded-lg border border-slate-800/80">${prop.item_c_consequences}</p>
        </div>
      `;
    }

    if (Array.isArray(prop.item_d_measures_taken) && prop.item_d_measures_taken.length > 0) {
      html += `
        <div class="space-y-1.5">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Medidas Técnicas Adoptadas (Art. 33.3.d):</span>
          <ul class="list-disc pl-5 text-xs text-slate-300 space-y-1 bg-slate-900/60 p-3 rounded-lg border border-slate-800/80 leading-relaxed">
            ${prop.item_d_measures_taken.map((m: any) => `<li>${m}</li>`).join("")}
          </ul>
        </div>
      `;
    }

    if (Array.isArray(prop.item_d_measures_proposed) && prop.item_d_measures_proposed.length > 0) {
      html += `
        <div class="space-y-1.5">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Medidas Adicionales Propuestas (Art. 33.3.d):</span>
          <ul class="list-disc pl-5 text-xs text-slate-300 space-y-1 bg-slate-900/60 p-3 rounded-lg border border-slate-800/80 leading-relaxed">
            ${prop.item_d_measures_proposed.map((m: any) => `<li>${m}</li>`).join("")}
          </ul>
        </div>
      `;
    }

    if (prop.body_plain) {
      html += `
        <div class="space-y-1.5">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Comunicación a los Titulares (Lenguaje Claro Art. 34):</span>
          <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800/80 text-xs text-slate-200 leading-relaxed whitespace-pre-wrap">${prop.body_plain}</div>
        </div>
      `;
    }

    if (Array.isArray(prop.safety_recommendations) && prop.safety_recommendations.length > 0) {
      html += `
        <div class="space-y-1.5">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Recomendaciones para los Titulares:</span>
          <ul class="list-disc pl-5 text-xs text-slate-300 space-y-1 bg-slate-900/60 p-3 rounded-lg border border-slate-800/80 leading-relaxed">
            ${prop.safety_recommendations.map((r: any) => `<li>${r}</li>`).join("")}
          </ul>
        </div>
      `;
    }

    if (Array.isArray(prop.citations) && prop.citations.length > 0) {
      html += `
        <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between flex-wrap gap-2 text-xs">
          <span class="text-xs font-semibold text-slate-400">Citas Normativas Verificadas:</span>
          <div class="flex flex-wrap gap-1.5">
            ${prop.citations.map((c: any) => `<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[11px] font-mono">${c}</span>`).join("")}
          </div>
        </div>
      `;
    }

    html += `</div>`;
    return html;
  }

  function renderPendingDecisions() {
    const pendingContainer = getEl<HTMLDivElement>("pending-decisions-container");
    const pendingCountBadge = getEl<HTMLSpanElement>("pending-count-badge");
    if (!pendingContainer) return;
    if (pendingCountBadge) {
      pendingCountBadge.textContent = `${pendingDecisions.length} pendientes`;
      if (pendingDecisions.length > 0) {
        pendingCountBadge.className = "px-2 py-0.5 rounded text-xs font-semibold bg-amber-950 text-amber-300 border border-amber-800";
      } else {
        pendingCountBadge.className = "px-2 py-0.5 rounded text-xs font-semibold bg-slate-800 text-slate-400";
      }
    }

    if (pendingDecisions.length === 0) {
      pendingContainer.innerHTML = `
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl text-center text-xs text-slate-500">
          No hay decisiones regulatorias pendientes de firma humana en este momento.
        </div>
      `;
      return;
    }

    pendingContainer.innerHTML = pendingDecisions
      .map((item, index) => {
        const disabledAttr = canChangeIncident ? "" : "disabled title=\"Permiso 'change_incident' requerido (Modo solo lectura)\"";
        const disabledClasses = canChangeIncident ? "" : "opacity-50 cursor-not-allowed";
        const propTargetId = `prop-view-${item.incident_id}-${item.pack_type || index}`;

        if (item.kind === "agent_blocked") {
          return `
          <div class="bg-rose-950/40 border border-rose-800/60 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class="px-2 py-0.5 rounded text-xs font-bold font-mono bg-rose-950 text-rose-300 border border-rose-800">
                  ${item.incident_code}
                </span>
                <span class="text-sm font-semibold text-rose-200">
                  Agente bloqueado — requiere intervención
                </span>
              </div>
              <p class="text-xs text-rose-300/80 font-mono">
                ${item.blocked_reason || "UNKNOWN"}
              </p>
              <p class="text-xs text-slate-400">
                El ciclo autónomo se detuvo con error y los reintentos no convergen. Revise el motivo, corrija la causa y el watcher retomará automáticamente.
              </p>
            </div>
          </div>
        `;
        }

        if (item.kind === "deadline_breached") {
          return `
          <div class="bg-amber-950/40 border border-amber-800/60 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class="px-2 py-0.5 rounded text-xs font-bold font-mono bg-amber-950 text-amber-300 border border-amber-800">
                  ${item.incident_code}
                </span>
                <span class="text-sm font-semibold text-amber-200">
                  Plazo vencido sin notificación (${item.blocked_reason || "T72_AUTHORITY"})
                </span>
              </div>
              <p class="text-xs text-slate-400">
                El plazo legal expiró sin paquete emitido. El pack Art. 33 debe incluir motivos del retraso (Art. 33(1)). Priorice la aprobación en cuanto el borrador esté listo.
              </p>
            </div>
          </div>
        `;
        }

        return `
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col space-y-3 shadow-sm hover:border-slate-700 transition-colors">
            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
              <div class="space-y-1 min-w-0">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="px-2 py-0.5 rounded text-xs font-bold font-mono bg-blue-950 text-blue-400 border border-blue-900 shrink-0">
                    ${item.incident_code}
                  </span>
                  <span class="text-sm font-semibold text-white">
                    Paquete de Notificación listo para emisión (${item.pack_type === "authority" ? "Autoridad Art. 33" : "Titulares Art. 34"})
                  </span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800 shrink-0">
                    Validación completada
                  </span>
                </div>
                <p class="text-xs text-slate-400">
                  ${item.blocked_reason || "Revisión completada. Esperando aprobación de la DPO."}
                </p>
              </div>

              <div class="flex items-center space-x-2 shrink-0 flex-wrap gap-y-2">
                <button
                  type="button"
                  data-toggle-prop="${propTargetId}"
                  title="Desplegar u ocultar el contenido detallado del borrador generado"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium transition-colors flex items-center space-x-1.5 border border-slate-700"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                  <span>Ver Detalle</span>
                </button>

                <button
                  type="button"
                  data-action="revision"
                  data-inc-id="${item.incident_id}"
                  data-inc-code="${item.incident_code}"
                  data-item-idx="${index}"
                  ${disabledAttr}
                  title="Devolver el borrador al agente autónomo con observaciones para regenerar el texto"
                  class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-medium transition-colors flex items-center space-x-1.5 border border-slate-700 ${disabledClasses}"
                >
                  <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Solicitar Revisión</span>
                </button>

                ${item.pack_type === "subject" ? `
                <button
                  type="button"
                  data-action="exemption"
                  data-inc-id="${item.incident_id}"
                  data-inc-code="${item.incident_code}"
                  data-item-idx="${index}"
                  ${disabledAttr}
                  title="Atestiguar formalmente medidas de protección técnica (cifrado) para eximir notificación a titulares (Art. 34.3.a GDPR)"
                  class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-medium transition-colors flex items-center space-x-1.5 border border-slate-700 ${disabledClasses}"
                >
                  <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>Atestiguar Exención</span>
                </button>
                ` : ""}

                <button
                  type="button"
                  data-action="approve"
                  data-inc-id="${item.incident_id}"
                  data-inc-code="${item.incident_code}"
                  data-item-idx="${index}"
                  ${disabledAttr}
                  title="Aprobar formalmente el paquete para su emisión y sellado criptográfico del bundle de evidencias"
                  class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition-colors flex items-center space-x-1.5 shadow-sm shadow-emerald-600/20 ${disabledClasses}"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Aprobar Emisión</span>
                </button>
              </div>
            </div>

            <div id="${propTargetId}" class="hidden pt-3 border-t border-slate-800">
              ${renderProposalHtml(item.proposal, item.pack_type)}
            </div>
          </div>
        `;
      })
      .join("");

    // Attach listeners for proposal toggle
    pendingContainer.querySelectorAll("button[data-toggle-prop]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-toggle-prop");
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.classList.toggle("hidden");
          const isHidden = targetEl.classList.contains("hidden");
          btn.innerHTML = isHidden
            ? `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg><span>Ver Detalle</span>`
            : `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg><span>Ocultar Detalle</span>`;
        }
      });
    });

    // Attach listeners to trigger modal
    pendingContainer.querySelectorAll("button[data-action]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!canChangeIncident) return;
        const action = btn.getAttribute("data-action");
        const incidentId = Number(btn.getAttribute("data-inc-id"));
        const incidentCode = btn.getAttribute("data-inc-code") || "";
        const itemIdx = Number(btn.getAttribute("data-item-idx") || "-1");
        const proposal = itemIdx >= 0 && pendingDecisions[itemIdx] ? pendingDecisions[itemIdx].proposal : null;

        window.dispatchEvent(
          new CustomEvent("cockpit:open-decision-modal", {
            detail: { action, incidentId, incidentCode, proposal },
          })
        );
      });
    });
  }

  function formatCitation(p: RetrievalPassage): string {
    const rawCitation = (p as any).citation;
    if (typeof rawCitation === "string" && rawCitation.trim().length > 0 && rawCitation !== "undefined") {
      return rawCitation;
    }
    const docMap: Record<string, string> = {
      "gdpr-full": "GDPR (RGPD)",
      "iso-27701": "ISO/IEC 27701",
      "ley-29733": "Ley 29733",
    };
    const doc = docMap[p.doc_id] || p.doc_id.toUpperCase();
    const clause = p.article_or_clause || p.chunk_id;
    return `${doc} · ${clause}`;
  }

  function cleanPassageText(text: string): string {
    return text.replace(/^\[DOC:[^\]]+\]\s*/i, "").trim();
  }

  function renderPassageCard(p: RetrievalPassage): string {
    const key = `${p.doc_id}:${p.chunk_id}:${p.lines}`;
    if (seenPassageKeys.has(key)) return "";
    seenPassageKeys.add(key);

    const citationLabel = formatCitation(p);
    const cleanText = cleanPassageText(p.text);
    const shortSha = p.chunk_sha256.slice(0, 10);

    return `
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3 shadow-sm hover:border-slate-700 transition-colors">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center space-x-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-950 text-blue-300 border border-blue-900">
              <svg class="w-3 h-3 mr-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              ${citationLabel}
            </span>
            <span class="text-xs text-slate-400 font-mono">
              Líneas: ${p.lines}
            </span>
          </div>

          <div class="flex items-center space-x-2 shrink-0">
            <!-- RAG Metrics Tooltip Trigger (No random colors) -->
            <div class="relative group/rag inline-block">
              <button
                type="button"
                tabindex="0"
                class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono transition-colors flex items-center space-x-1.5 cursor-help"
                title="Inspeccionar métricas de recuperación RAG"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span>Puntajes RAG</span>
                <span class="text-slate-400 font-sans text-[11px]">(Rerank: ${Number(p.rerank_score).toFixed(2)})</span>
              </button>

              <!-- Popover Tooltip with NO random colors -->
              <div class="invisible group-hover/rag:visible group-focus-within/rag:visible absolute right-0 top-full mt-1.5 z-30 w-64 p-3 bg-slate-900 border border-slate-700 rounded-lg shadow-xl text-xs space-y-2 pointer-events-none transition-all">
                <div class="text-[11px] font-semibold text-slate-300 border-b border-slate-800 pb-1 flex items-center justify-between">
                  <span>Métricas de Recuperación RAG</span>
                  <span class="text-slate-400 font-mono text-[10px]">Dual-Modal</span>
                </div>
                <div class="space-y-1.5 text-xs">
                  <div class="flex justify-between items-center text-slate-400">
                    <span>Similitud Densa (Dense):</span>
                    <span class="font-mono text-slate-200 tabular-nums">${p.dense_score !== null && p.dense_score !== undefined ? Number(p.dense_score).toFixed(4) : "—"}</span>
                  </div>
                  <div class="flex justify-between items-center text-slate-400">
                    <span>Rango Léxico (BM25):</span>
                    <span class="font-mono text-slate-200 tabular-nums">${p.bm25_rank !== null && p.bm25_rank !== undefined ? `#${p.bm25_rank}` : "—"}</span>
                  </div>
                  <div class="flex justify-between items-center text-slate-400">
                    <span>Reciprocal Rank (RRF):</span>
                    <span class="font-mono text-slate-200 tabular-nums">${Number(p.rrf_score).toFixed(4)}</span>
                  </div>
                  <div class="flex justify-between items-center text-slate-400">
                    <span>Rerank Cross-Encoder:</span>
                    <span class="font-mono text-slate-200 font-semibold tabular-nums">${Number(p.rerank_score).toFixed(4)}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Copy Hash Button -->
            <button
              type="button"
              data-copy-hash="${p.chunk_sha256}"
              class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors text-xs flex items-center space-x-1 border border-slate-700 shrink-0"
              title="Copiar hash del fragmento"
            >
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span class="font-mono text-[10px]">${shortSha}…</span>
            </button>
          </div>
        </div>

        <blockquote class="text-xs text-slate-200 bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 leading-relaxed font-sans">
          "${cleanText}"
        </blockquote>
      </div>
    `;
  }

  function attachCopyHashListeners() {
    document.querySelectorAll<HTMLButtonElement>("button[data-copy-hash]").forEach((btn) => {
      if (btn.hasAttribute("data-copy-bound")) return;
      btn.setAttribute("data-copy-bound", "true");
      btn.addEventListener("click", () => {
        const hash = btn.getAttribute("data-copy-hash");
        if (hash && hash.trim().length > 0) {
          navigator.clipboard.writeText(hash.trim());
          const original = btn.innerHTML;
          btn.innerHTML = `<span class="text-emerald-400 text-[10px]">¡Copiado!</span>`;
          setTimeout(() => {
            btn.innerHTML = original;
          }, 1500);
        }
      });
    });
  }

  function renderRagRetrievals(records: Array<{ passages: RetrievalPassage[] }>) {
    const ragContainer = getEl<HTMLDivElement>("rag-citations-container");
    if (!ragContainer || !Array.isArray(records) || records.length === 0) return;
    let html = "";
    for (const record of records) {
      if (Array.isArray(record.passages)) {
        for (const p of record.passages) {
          html += renderPassageCard(p);
        }
      }
    }
    if (html.length > 0) {
      if (ragContainer.textContent?.includes("Esperando eventos")) {
        ragContainer.innerHTML = html;
      } else {
        ragContainer.insertAdjacentHTML("afterbegin", html);
      }
      attachCopyHashListeners();
    }
  }

  // Timer ticker
  setInterval(() => {
    const timerEls = document.querySelectorAll("[data-timer-id]");
    for (const el of timerEls) {
      let ms = Number(el.getAttribute("data-ms") || "0");
      if (ms > 0) {
        ms = Math.max(0, ms - 1000);
        el.setAttribute("data-ms", String(ms));
      }
      el.textContent = formatRemainingTime(ms);
    }
  }, 1000);

  // Initialize with current snapshot if available or proactive fetch
  async function initCompliancePage() {
    const existingSnapshot = sseClient.getState().snapshot;
    if (existingSnapshot) {
      activeTimers = existingSnapshot.timers;
      pendingDecisions = existingSnapshot.pending_decisions;
      renderTimers();
      renderPendingDecisions();
      if (existingSnapshot.recent_rag_retrievals) {
        renderRagRetrievals(existingSnapshot.recent_rag_retrievals);
      }
    }
    try {
      const response = await authenticatedFetch("/api/compliance");
      if (response.ok) {
        const data = (await response.json()) as {
          timers: CockpitTimer[];
          pending_decisions: PendingDecision[];
          recent_rag_retrievals?: Array<{ passages: RetrievalPassage[] }>;
        };
        if (Array.isArray(data.timers)) {
          activeTimers = data.timers;
        }
        if (Array.isArray(data.pending_decisions)) {
          pendingDecisions = data.pending_decisions;
        }
        renderTimers();
        renderPendingDecisions();
        if (Array.isArray(data.recent_rag_retrievals)) {
          renderRagRetrievals(data.recent_rag_retrievals);
        }
      }
    } catch {
      // SSE snapshot will hydrate
    }
  }

  document.addEventListener("astro:page-load", () => {
    void initCompliancePage();
  });
  void initCompliancePage();

  // SSE snapshot listener
  window.addEventListener("cockpit:snapshot", ((e: CustomEvent<StreamSnapshot>) => {
    activeTimers = e.detail.timers;
    pendingDecisions = e.detail.pending_decisions;
    renderTimers();
    renderPendingDecisions();
    if (e.detail.recent_rag_retrievals) {
      renderRagRetrievals(e.detail.recent_rag_retrievals);
    }
  }) as EventListener);

  // SSE agent event listener
  window.addEventListener("cockpit:agent-event", ((e: CustomEvent<AgentEvent>) => {
    const event = e.detail;
    if (event.type === "scheduler:timer_tick") {
      const idx = activeTimers.findIndex((x) => x.timer_id === event.timer_id);
      if (idx !== -1) {
        activeTimers[idx].remaining_ms = event.remaining_ms;
      } else {
        activeTimers.push({
          timer_id: event.timer_id,
          incident_code: event.incident_code,
          timer_type: event.timer_kind,
          fire_at_utc: event.fire_at_utc,
          remaining_ms: event.remaining_ms,
        });
      }
      renderTimers();
    } else if (event.type === "rag:retrieval") {
      const ragContainer = getEl<HTMLDivElement>("rag-citations-container");
      if (ragContainer) {
        let html = "";
        for (const p of event.passages) {
          html += renderPassageCard(p);
        }
        if (html.length > 0) {
          if (ragContainer.textContent?.includes("Esperando eventos")) {
            ragContainer.innerHTML = html;
          } else {
            ragContainer.insertAdjacentHTML("afterbegin", html);
          }
          attachCopyHashListeners();
        }
      }
    }
  }) as EventListener);
</script>
