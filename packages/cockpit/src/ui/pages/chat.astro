    chkCompressIdle?.addEventListener("change", () => {
      traceStore.setCompressIdle(chkCompressIdle.checked);
    });

    traceSearch?.addEventListener("input", () => {
      traceStore.setSearchQuery(traceSearch.value);
    });

    document.getElementById("btn-zoom-in")?.addEventListener("click", () => {
