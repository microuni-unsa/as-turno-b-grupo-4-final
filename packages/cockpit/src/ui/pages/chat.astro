      aggregatesPane?.classList.add("hidden");
    });

    tabAggregates?.addEventListener("click", () => {
      tabAggregates.className = "inspector-tab px-4 py-2 border-b-2 border-blue-500 font-semibold text-white text-[11px]";
      tabInspector!.className = "inspector-tab px-4 py-2 border-b-2 border-transparent text-slate-400 hover:text-white font-semibold text-[11px]";
      inspectorPane?.classList.add("hidden");
      aggregatesPane?.classList.remove("hidden");
    });

    // Helpers
    function setText(id: string, text: string): void {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // --- Subscriptions ---
    chatStore.subscribe(() => {
      renderSessions();
      renderMessages();
    });

    traceStore.subscribe(() => {
      renderTraceView();
    });

    // Initial Renders
    renderSessions();
    renderMessages();
    updatePersonaButtons();
    updateIncidentContextDisplay();

    // Check SSE snapshot for warnings
    const snapshot = sseClient.getState().snapshot;
    if (snapshot?.pending_decisions && snapshot.pending_decisions.length > 0 && warningBanner && warningText) {
      warningText.textContent = `Atención: Hay ${snapshot.pending_decisions.length} incidentes pendientes de firma DPO en el sistema.`;
      warningBanner.classList.remove("hidden");
    }
  }

  document.addEventListener("astro:page-load", initChatApp);
  initChatApp();

  window.addEventListener("cockpit:snapshot", ((e: CustomEvent<StreamSnapshot>) => {
    const pendings = e.detail.pending_decisions;
    const warningBanner = document.getElementById("chat-warning-banner");
    const warningText = document.getElementById("chat-warning-text");
    if (pendings && pendings.length > 0 && warningBanner && warningText) {
      warningText.textContent = `Atención: Hay ${pendings.length} incidentes pendientes de firma DPO en el sistema.`;
      warningBanner.classList.remove("hidden");
    }
  }) as EventListener);
</script>
