    // --- Inline User Message Editing ---
    function openInlineEdit(container: HTMLElement, node: ChatMessageNode): void {
      const originalHtml = container.innerHTML;
      container.innerHTML = `
        <div class="w-full max-w-xl bg-slate-900 border border-blue-500 rounded-2xl p-3 space-y-2">
          <p class="text-[11px] font-semibold text-blue-400">Editar consulta y crear nueva rama:</p>
          <textarea class="edit-textarea w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-100 focus:outline-none focus:border-blue-500 resize-none" rows="3">${escapeHtml(node.text)}</textarea>
          <div class="flex items-center justify-end space-x-2">
            <button type="button" class="btn-cancel-edit px-2.5 py-1 rounded-lg text-slate-400 hover:text-white text-xs">Cancelar</button>
            <button type="button" class="btn-save-edit px-3 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs">Guardar y Enviar</button>
          </div>
        </div>
      `;

      const textarea = container.querySelector(".edit-textarea") as HTMLTextAreaElement;
      const cancelBtn = container.querySelector(".btn-cancel-edit");
      const saveBtn = container.querySelector(".btn-save-edit");

      textarea?.focus();

      cancelBtn?.addEventListener("click", () => {
        container.innerHTML = originalHtml;
        renderMessages();
      });

      saveBtn?.addEventListener("click", () => {
        const newText = textarea.value.trim();
        if (newText && newText !== node.text) {
          const newUserNode = chatStore.editUserMessage(node.id, newText);
          void executeChat(newText, newUserNode.id);
        } else {
          container.innerHTML = originalHtml;
          renderMessages();
        }
      });
    }

    // --- Send & Execution Pipeline ---
    async function executeChat(queryText: string, userNodeId?: string): Promise<void> {
      let targetUserNodeId = userNodeId;
      if (!targetUserNodeId) {
        const node = chatStore.addUserMessage(queryText, activeIncidentContext, currentPersona);
        targetUserNodeId = node.id;
      }

      renderMessages();

      // Show typing indicator
      const typingDiv = document.createElement("div");
      typingDiv.id = "chat-typing-indicator";
      typingDiv.className = "flex items-center space-x-2 text-xs text-slate-400 italic py-2 px-2";
      typingDiv.innerHTML = `
        <div class="w-3.5 h-3.5 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        <span>Consultando registros normativos, plazos regulatorios y evidencia...</span>
      `;
      messagesContainer?.appendChild(typingDiv);
      if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;

      try {
        const response = await sendChat(queryText, activeIncidentContext, currentPersona);
        typingDiv.remove();

        chatStore.addAssistantResponse(targetUserNodeId, response);
        traceStore.addTrace(response.trace, true);

        if (response.pending_decisions && response.pending_decisions.length > 0) {
          if (warningBanner && warningText) {
            warningText.textContent = `Atención: Hay ${response.pending_decisions.length} decisiones regulatorias pendientes de aprobación humana.`;
            warningBanner.classList.remove("hidden");
          }
        }
      } catch (err: unknown) {
        typingDiv.remove();
        const msg = err instanceof Error ? err.message : "Error desconocido";
        const fallbackTrace: ChatTrace = {
          id: `trace-err-${Date.now()}`,
          title: `Error [${currentPersona}]`,
          start_iso: new Date().toISOString(),
          wall_time_ms: 50,
          model_time_ms: 0,
          tool_time_ms: 0,
          idle_time_ms: 50,
          turns_count: 1,
          requests_count: 1,
          tool_calls_count: 0,
          spans: [
            {
              id: "span-err",
              name: "error",
              type: "agent",
              status: "error",
              start_ms: 0,
              end_ms: 50,
              duration_ms: 50,
              relative_start_ms: 0,
              error: msg,
              track: "Main",
            },
          ],
          aggregates: [],
        };

        chatStore.addAssistantResponse(
          targetUserNodeId,
          {
            reply: `Error al procesar la consulta: ${msg}`,
            persona: currentPersona,
            citations: [],
            pending_decisions: [],
            tool_calls: [],
            trace: fallbackTrace,
          },
          true
        );
      }
    }

    async function handleSend(): Promise<void> {
      if (!chatInput) return;
      const text = chatInput.value.trim();
      if (!text) return;
      chatInput.value = "";
      await executeChat(text);
    }

    chatInput.onkeydown = (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        void handleSend();
      }
    };

    btnSendChat?.addEventListener("click", () => {
      void handleSend();
    });

    // --- RENDER TRACE VIEW (OMP STATS STYLE) ---
    function renderTraceView(): void {
      const trace = traceStore.getActiveTrace();
      if (!trace) {
        if (traceSelector) {
          traceSelector.innerHTML = '<option value="">Sin trazas disponibles</option>';
        }
        return;
      }

      // Populate trace selector
      const allTraces = traceStore.getTraces();
      if (traceSelector) {
        traceSelector.innerHTML = allTraces
          .map((t) => `<option value="${t.id}" ${t.id === trace.id ? "selected" : ""}>${escapeHtml(t.title)} (${(t.wall_time_ms / 1000).toFixed(2)}s)</option>`)
          .join("");

        traceSelector.onchange = () => {
          traceStore.setActiveTrace(traceSelector.value);
        };
      }

      // Update Top Metrics Strip
      const wallS = (trace.wall_time_ms / 1000).toFixed(2);
      const modelS = (trace.model_time_ms / 1000).toFixed(2);
      const toolS = (trace.tool_time_ms / 1000).toFixed(2);
      const idleS = (trace.idle_time_ms / 1000).toFixed(2);

      const modelPct = trace.wall_time_ms > 0 ? ((trace.model_time_ms / trace.wall_time_ms) * 100).toFixed(1) : "0";
      const toolPct = trace.wall_time_ms > 0 ? ((trace.tool_time_ms / trace.wall_time_ms) * 100).toFixed(1) : "0";
      const idlePct = trace.wall_time_ms > 0 ? ((trace.idle_time_ms / trace.wall_time_ms) * 100).toFixed(1) : "0";

      setText("metric-wall-time", `${wallS}s`);
      setText("metric-model-time", `${modelS}s`);
      setText("metric-model-pct", `${modelPct}% wall`);
      setText("metric-tool-time", `${toolS}s`);
      setText("metric-tool-pct", `${toolPct}% wall`);
      setText("metric-idle-time", `${idleS}s`);
      setText("metric-idle-pct", `${idlePct}% wall`);
      setText("metric-turns", String(trace.turns_count));
      setText("metric-tool-calls", String(trace.tool_calls_count));
      setText("metric-tokens", String(trace.tokens_estimate || 0));
      setText("metric-cost", `$${(trace.cost_estimate_usd || 0).toFixed(4)}`);

      // Filter spans
      const query = traceStore.getSearchQuery().toLowerCase().trim();
      const filteredSpans = query
        ? trace.spans.filter((s) => s.name.toLowerCase().includes(query) || s.type.toLowerCase().includes(query))
        : trace.spans;

      if (transcriptCount) {
        transcriptCount.textContent = `${filteredSpans.length} spans`;
      }

      // Render Transcript List
      if (transcriptList) {
        transcriptList.innerHTML = "";
        const selectedSpan = traceStore.getSelectedSpan();

        for (const span of filteredSpans) {
          const isSelected = selectedSpan?.id === span.id;
          const row = document.createElement("button");
          row.type = "button";
          row.className = `w-full text-left p-2 rounded-lg flex items-center justify-between transition-colors border ${
            isSelected
              ? "bg-blue-600/20 border-blue-500/60 text-white"
              : "hover:bg-slate-900 border-transparent text-slate-300"
          }`;

          const typeColors: Record<string, string> = {
            turn: "bg-sky-950 text-sky-400 border-sky-800",
            model: "bg-purple-950 text-purple-400 border-purple-800",
            tool: "bg-emerald-950 text-emerald-400 border-emerald-800",
            agent: "bg-amber-950 text-amber-400 border-amber-800",
          };
          const badgeClass = typeColors[span.type] || "bg-slate-900 text-slate-400 border-slate-700";

          row.innerHTML = `
            <div class="flex items-center space-x-2 min-w-0 pr-2">
              <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold border ${badgeClass}">${span.type}</span>
              <span class="font-medium text-xs truncate">${escapeHtml(span.name)}</span>
            </div>
            <div class="flex items-center space-x-3 shrink-0 text-[10px] text-slate-400 font-mono">
              <span class="${span.duration_ms > 200 ? "text-amber-400" : ""}">${span.duration_ms.toFixed(1)}ms</span>
              <span class="text-slate-500">+${(span.relative_start_ms / 1000).toFixed(2)}s</span>
            </div>
          `;

          row.onclick = () => {
            traceStore.setSelectedSpan(span.id);
          };

          transcriptList.appendChild(row);
        }
      }

      // Render Timeline SVG Lanes
      renderTimelineSvg(trace, filteredSpans);

      // Render Inspector Pane
      renderInspectorPane(trace);

      // Render Aggregates Table
      renderAggregatesTable(trace);
    }

    function renderTimelineSvg(trace: ChatTrace, spans: ChatTraceSpan[]): void {
      if (!timelineSvg) return;
      timelineSvg.innerHTML = "";

      const width = timelineSvg.clientWidth || 800;
      const height = timelineSvg.clientHeight || 128;
      const maxMs = Math.max(trace.wall_time_ms, 100) / zoomLevel;

      // Lanes definitions
      const lanes = [
        { name: "Main", y: 15, color: "#f59e0b" },
        { name: "Turns", y: 42, color: "#38bdf8" },
        { name: "Model", y: 69, color: "#a855f7" },
        { name: "Tools", y: 96, color: "#10b981" },
      ];

      // Draw background lane lines & labels
      for (const lane of lanes) {
        const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
        text.setAttribute("x", "8");
        text.setAttribute("y", String(lane.y + 12));
        text.setAttribute("fill", "#64748b");
        text.setAttribute("font-size", "10");
        text.setAttribute("font-family", "monospace");
        text.textContent = lane.name;
        timelineSvg.appendChild(text);

        const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
        line.setAttribute("x1", "55");
        line.setAttribute("x2", String(width));
        line.setAttribute("y1", String(lane.y + 10));
        line.setAttribute("y2", String(lane.y + 10));
        line.setAttribute("stroke", "#1e293b");
        line.setAttribute("stroke-width", "1");
        timelineSvg.appendChild(line);
      }

      const laneXStart = 55;
      const usableWidth = width - laneXStart - 10;
      const selectedSpan = traceStore.getSelectedSpan();

      // Draw Spans
      for (const span of spans) {
        let laneY = 96;
        let color = "#10b981";

        if (span.type === "turn") {
          laneY = 42;
          color = "#38bdf8";
        } else if (span.type === "model") {
          laneY = 69;
          color = "#a855f7";
        } else if (span.type === "agent") {
          laneY = 15;
          color = "#f59e0b";
        }

        const startX = laneXStart + (span.relative_start_ms / maxMs) * usableWidth;
        const spanWidth = Math.max(4, (span.duration_ms / maxMs) * usableWidth);
        const isSelected = selectedSpan?.id === span.id;

        const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        rect.setAttribute("x", String(startX));
        rect.setAttribute("y", String(laneY));
        rect.setAttribute("width", String(spanWidth));
        rect.setAttribute("height", "18");
        rect.setAttribute("rx", "4");
        rect.setAttribute("fill", isSelected ? "#ffffff" : color);
        rect.setAttribute("fill-opacity", isSelected ? "0.9" : "0.75");
        rect.setAttribute("stroke", isSelected ? "#3b82f6" : color);
        rect.setAttribute("stroke-width", isSelected ? "2" : "1");
        rect.setAttribute("cursor", "pointer");

        rect.onclick = () => {
          traceStore.setSelectedSpan(span.id);
        };

        const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
        title.textContent = `${span.name} (${span.duration_ms.toFixed(1)}ms)`;
        rect.appendChild(title);

        timelineSvg.appendChild(rect);
      }
    }

    function renderInspectorPane(trace: ChatTrace): void {
      const selected = traceStore.getSelectedSpan();
      const emptyDiv = document.getElementById("inspector-empty");
      const contentDiv = document.getElementById("inspector-content");

      if (!selected) {
        emptyDiv?.classList.remove("hidden");
        contentDiv?.classList.add("hidden");
        return;
      }

      emptyDiv?.classList.add("hidden");
      contentDiv?.classList.remove("hidden");

      setText("inspector-span-name", selected.name);
      setText("inspector-span-track", `Carril: ${selected.track || "Main"}`);
      setText("inspector-span-badge", selected.type);
      setText("inspector-span-duration", `${selected.duration_ms.toFixed(2)}ms`);
      setText("inspector-span-start", `+${(selected.relative_start_ms / 1000).toFixed(3)}s`);

      const argsEl = document.getElementById("inspector-span-args");
      if (argsEl) {
        argsEl.textContent = selected.args ? JSON.stringify(selected.args, null, 2) : "{}";
      }

      const resultEl = document.getElementById("inspector-span-result");
      if (resultEl) {
        if (selected.error) {
          resultEl.textContent = `Error: ${selected.error}`;
        } else if (typeof selected.result === "string") {
          resultEl.textContent = selected.result;
        } else if (selected.result) {
          resultEl.textContent = JSON.stringify(selected.result, null, 2);
        } else {
          resultEl.textContent = "Sin datos de retorno";
        }
      }

      document.getElementById("btn-copy-args")?.addEventListener("click", () => {
        navigator.clipboard.writeText(argsEl?.textContent || "");
      });
      document.getElementById("btn-copy-result")?.addEventListener("click", () => {
        navigator.clipboard.writeText(resultEl?.textContent || "");
      });
    }

