      const tbody = document.getElementById("aggregates-table-body");
      if (!tbody) return;

      if (!trace.aggregates || trace.aggregates.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-500 italic">No se registraron herramientas</td></tr>';
        return;
      }

      tbody.innerHTML = trace.aggregates
        .map(
          (a) => `
        <tr class="border-b border-slate-900 hover:bg-slate-900/60">
          <td class="py-2 px-1 font-semibold text-emerald-400">${escapeHtml(a.tool)}</td>
          <td class="py-2 px-1 text-center">${a.calls}</td>
          <td class="py-2 px-1 text-center ${a.errors > 0 ? "text-rose-400 font-bold" : "text-slate-500"}">${a.errors}</td>
          <td class="py-2 px-1 text-right text-slate-200">${a.total_ms.toFixed(1)}ms</td>
          <td class="py-2 px-1 text-right text-slate-400">${a.avg_ms.toFixed(1)}ms</td>
          <td class="py-2 px-1 text-right text-slate-400">${a.max_ms.toFixed(1)}ms</td>
        </tr>
      `
        )
        .join("");
