    // --- Trace Controls Listeners ---
    axisBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-axis") as AxisMode;
        if (mode) {
          traceStore.setAxisMode(mode);
          axisBtns.forEach((b) => (b.className = "axis-btn px-2 py-0.5 rounded text-slate-400 hover:text-white font-medium"));
