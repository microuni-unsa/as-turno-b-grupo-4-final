# ==============================================================================
# Incident Agent Configuration Template (.env.example)
# Copy to .env and configure local credentials.
# ==============================================================================

# --- Model Provider & API Credentials ---
# Supports standard OpenAI or any OpenAI-compatible API (Mistral, Groq, Ollama, vLLM)
OPENAI_API_KEY=your_openai_or_mistral_api_key_here
OPENAI_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_optional_cohere_key_here

# Model routing format: provider,model,endpoint,auth_env,timeout_ms,max_retries,fallback:none
REASONING_MODEL=openai,ministral-8b-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,15000,2,fallback:none
FAST_MODEL=openai,ministral-3b-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,10000,2,fallback:none
VISION_MODEL=openai,pixtral-12b-2409,https://api.mistral.ai/v1,OPENAI_API_KEY,15000,2,fallback:none
EMBEDDINGS_MODEL=openai,mistral-embed,https://api.mistral.ai/v1,OPENAI_API_KEY,10000,2,fallback:none
RERANKER_MODEL=openai,ministral-3b-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,10000,2,fallback:none

# --- PIMS API Connection Settings ---
# PIMS API target: mock Hono server URL for local/demo, or live tenant URL (e.g. https://unsa.27k.pe)
PIMS_BASE_URL=http://localhost:3000
# PIMS_EXTRA_HEADERS_JSON={"X-Custom-Tenant":"unsa"}
# PIMS_COOKIES_JSON={"session":"abc123xyz"}
PIMS_SCHEMA=unsa
# PIMS Authentication: PIMS_USERNAME + PIMS_PASSWORD (plain env value)
PIMS_USERNAME=grupob4
PIMS_PASSWORD=replace_with_pims_password
PIMS_TIMEOUT_MS=5000
PIMS_MAX_RETRIES=3
PIMS_PAGE_SIZE=50/100
IDEMPOTENCY_KEY_PREFIX=pims_idemp_

# --- Autonomous Watcher Daemon ---
# AUTO_NOTIFY=false parks approved notices at AWAITING_APPROVAL for human approval.
AUTO_NOTIFY=false
MODEL_LOGPROBS=true
PHASE_DUE_HOURS=24
REVIEW_CHALLENGE_BLOCKING=true
WATCHER_POLL_INTERVAL_MS=5000

# --- Dual-Modal RAG Subsystem Settings ---
# Configurable corpus path: local directory or remote S3 bucket
RAG_CORPUS_DIR=corpus
# RAG_S3_BUCKET=my-compliance-corpus-bucket
# RAG_S3_PREFIX=corpus/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RAG_TOP_K=8
RAG_RERANK_K=4
RAG_MIN_SCORE=0.35
RAG_TIMEOUT_MS=3000

# --- Evidence Store, HMAC & Security Invariants ---
EVIDENCE_HASH=sha256
EVIDENCE_KEY_ENV=EVIDENCE_KEY
# 64 hex characters (32 bytes) for AES-256-GCM
EVIDENCE_KEY=
# PostgreSQL connection URI for the evidence store and pgvector index
EVIDENCE_DB_URL=postgres://pims:pims@localhost:5432/pims_evidence
WEBHOOK_INGEST_SECRET_ENV=WEBHOOK_INGEST_SECRET
LOG_PII=false

# --- Guided Creation & PII Redaction (spec §8.4 / §11.3) ---
# Presidio analyzer sidecar: pinned image + Spanish model; unreachable → PII_REDACTION_UNAVAILABLE (fail-closed).
# PRESIDIO_URL=http://127.0.0.1:3001
# PRESIDIO_IMAGE=presidio-analyzer:2.2.x-es
# PRESIDIO_MODEL=es_core_news_md
# PRESIDIO_TIMEOUT_MS=1500
# PRESIDIO_MIN_SCORE=0.5
# FORM_NARRATIVE_MAX_CHARS=4000
