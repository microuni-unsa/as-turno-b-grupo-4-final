# ==============================================================================
# Incident Agent Configuration Template (.env.example)
# Copy to .env and configure secrets or use SOPS encrypted credentials.
# ==============================================================================

# --- Model Provider & API Credentials ---
# Supports standard OpenAI or any OpenAI-compatible API (Mistral, Groq, Ollama, vLLM)
OPENAI_API_KEY=your_openai_or_mistral_api_key_here
OPENAI_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_optional_cohere_key_here

# Model routing format: provider,model,endpoint,auth_env,timeout_ms,max_retries,fallback:none
REASONING_MODEL=openai,mistral-large-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,5000,2,fallback:none
FAST_MODEL=openai,mistral-small-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,5000,2,fallback:none
VISION_MODEL=openai,pixtral-12b-2409,https://api.mistral.ai/v1,OPENAI_API_KEY,5000,2,fallback:none
EMBEDDINGS_MODEL=openai,mistral-embed,https://api.mistral.ai/v1,OPENAI_API_KEY,5000,2,fallback:none
RERANKER_MODEL=openai,mistral-small-latest,https://api.mistral.ai/v1,OPENAI_API_KEY,5000,2,fallback:none

# --- PIMS API Connection Settings ---
PIMS_BASE_URL=http://localhost:3000
PIMS_SCHEMA=http
PIMS_TOKEN_CMD=["echo", "pims-dev-token-secret-xyz"]
PIMS_TIMEOUT_MS=5000
PIMS_MAX_RETRIES=3
PIMS_PAGE_SIZE=50/100
IDEMPOTENCY_KEY_PREFIX=pims_idemp_

# --- Tri-Modal RAG Subsystem Settings ---
# Configurable corpus path: local directory or remote S3 bucket
RAG_CORPUS_DIR=corpus
# RAG_S3_BUCKET=my-compliance-corpus-bucket
# RAG_S3_PREFIX=corpus/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RAG_TOP_K=8
RAG_RERANK_K=4
RAG_MIN_SCORE=0.35
RAG_TIMEOUT_MS=3000

# --- Evidence Store, HMAC & Security Invariants ---
EVIDENCE_HASH=sha256
EVIDENCE_KEY_ENV=EVIDENCE_KEY
WEBHOOK_INGEST_SECRET_ENV=WEBHOOK_INGEST_SECRET
LOG_PII=false

# --- SOPS Credentials Management ---
SOPS_CREDENTIALS_PATH=credentials.enc.json
