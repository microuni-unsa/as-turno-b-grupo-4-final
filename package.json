{
  "name": "incident-agent-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "check": "biome check && tsc --noEmit",
    "check:fix": "biome check --write && tsc --noEmit",
    "dev:ui": "bun --filter @pims/cockpit dev:ui",
    "build:ui": "bun --filter @pims/cockpit build:ui",
    "build:server": "bun build packages/cockpit/src/server.ts --outdir dist --target bun --external cpu-features --external ssh2",
    "build": "bun run build:ui && bun run build:server",
    "start": "bun run packages/cockpit/src/server.ts",
    "dev": "microenv dev --def ./packages/config/src/env-matrix.ts --stack ./packages/config/src/stack-def.ts --preset dev --local",
    "stack:dev": "bun run scripts/dev-stack.ts",
    "env:check": "microenv check --def ./packages/config/src/env-matrix.ts",
    "env:diff": "microenv diff --def ./packages/config/src/env-matrix.ts dev prod",
    "env:materialize:dev": "microenv materialize --def ./packages/config/src/env-matrix.ts --env dev --out .env --force",
    "env:materialize:prod": "microenv materialize --def ./packages/config/src/env-matrix.ts --env prod --out .env --force",
    "decrypt": "sops -d --output .env .enc.env"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@microx-technologies/microcompose": "0.1.0",
    "@microx-technologies/microenv": "0.1.1"
  }
}
