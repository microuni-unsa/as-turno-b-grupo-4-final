    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "postgres": "^4.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
